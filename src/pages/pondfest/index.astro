---
import Layout from "../../layouts/PondFestLayout.astro";
import PondFestCountdown from "../../components/pondfest/PondFestCountdown.astro";
import PondFestVideo from "../../components/pondfest/PondFestVideo.astro";
import EmailCTAModal from "../../components/pondfest/EmailCTAModal.astro";
import PondFestQuickLinks from "../../components/pondfest/PondFestQuickLinks.astro";
import PondFestSectionNav from "../../components/pondfest/PondFestSectionNav.astro";
import {
  CURRENT_YEAR,
  EVENT_DATE,
  EVENT_DATE_DISPLAY,
  EVENT_TIME,
  EVENT_LOCATION,
  EVENT_TAGLINE,
  FUNDRAISING_GOAL,
  HERO_IMAGE_URL,
  HERO_IMAGE_MOBILE_URL,
  OG_IMAGE_URL,
  MERCH_URL,
  MERCH_PRESALE_DEADLINE,
  MERCH_PRESALE_DEADLINE_DISPLAY,
  MERCH_INTRO,
  MERCH_ITEMS,
  MERCH_AT_THE_FEST,
  PONDFEST_DONATE_URL,
  VOLUNTEER_URL,
  SPONSOR_URL,
  VENDOR_URL,
  PONDFEST_EMAIL,
  FACEBOOK_URL,
  INSTAGRAM_URL,
  FACEBOOK_EVENT_URL,
  HASHTAGS,
  LINEUP,
  EMCEES,
  SPONSORS,
  PARTNERS,
  PARTNERS_INTRO,
  FUNDING_GOALS,
  AMENITIES,
  AMENITIES_INTRO,
  EVERY_AREA,
  SUPPORT_DISCLOSURE,
  SUPPORT_DISCLOSURE_TITLE,
  FAQ,
  DAY_OF_ALERT,
  SHUTTLE_INFO,
  PARKING_NOTES,
  FEE_NOTE,
  BRING_NOTE,
  RAIN_DATE_NOTE,
  DOG_NOTE,
  RAFFLE_LINK,
  AUCTION_LINK,
  FEEDBACK_LINK,
  EVENT_MAP_IMAGE_URL,
  EVENT_MAP_FULL_URL,
  PARKING_MAP_IMAGE_URL,
  VENDOR_MAP_IMAGE_URL,
  PHOTO_BAND_1_URL,
  PHOTO_BAND_1_MOBILE_URL,
  GALLERY_PHOTOS,
  GALLERY_PREVIEW_COUNT,
  PHOTO_CREDIT_NAME,
  PHOTO_CREDIT_URL,
  HISTORY_BG_PHOTO,
  SEVENTY_FIFTH_URL,
  SEVENTY_FIFTH_LOGO_WHITE,
  HEART_OF_PARKS_VIDEO_URL,
  HEART_OF_PARKS_POSTER_URL,
  HEART_OF_PARKS_CAPTIONS_URL,
  ANNUAL_PROMISE,
  ANNUAL_PROMISE_SHORT,
  PHASE_OVERRIDE,
  EVENT_MAPS,
  KEY_TIMES,
  OPEN_MIC_SLOTS,
  FOOD_TRUCKS,
  TAP_LIST,
  CRAFT_VENDORS,
  FIRST_RESPONDERS,
  SPONSOR_ADS,
  SPONSOR_AD_SIZES,
  OUT_AND_ABOUT_URL,
  OUT_AND_ABOUT_LABEL,
  THANKS_GROUPS,
  EAGLE_SCOUT_NOTE,
  NEXT_EVENT_DATE_DISPLAY,
} from "../../data/pondfest/config";
import {
  WINNERS_LIVE,
  FIFTY_FIFTY_TICKET,
  FIFTY_FIFTY_AMOUNT,
  RAFFLE_WINNERS,
  AUCTION_WINNERS,
  WINNERS_NOTE,
  WINNERS_CLAIM_NOTE,
  WINNERS_WHERE,
  parseWinners,
} from "../../data/pondfest/winners";
import { resolvePhase } from "../../data/pondfest/phase";
import type { NavSection, Phase, SponsorTier } from "../../data/pondfest/types";
import { publicImageSize } from "../../data/pondfest/imageSize";
import PondFestNext from "../../components/pondfest/PondFestNext.astro";

// Which job the page is doing today. Decided here so the HTML is right
// without JavaScript, and again by the inline script in the head so the
// page flips itself overnight without a deploy.
const phase: Phase = resolvePhase(EVENT_DATE, Date.now(), PHASE_OVERRIDE);

const hasMaps =
  EVENT_MAP_IMAGE_URL || PARKING_MAP_IMAGE_URL || VENDOR_MAP_IMAGE_URL;

const sponsorsByTier = {
  diamond: SPONSORS.filter((s) => s.tier === "diamond"),
  platinum: SPONSORS.filter((s) => s.tier === "platinum"),
  gold: SPONSORS.filter((s) => s.tier === "gold"),
  silver: SPONSORS.filter((s) => s.tier === "silver"),
  bronze: SPONSORS.filter((s) => s.tier === "bronze"),
  family: SPONSORS.filter((s) => s.tier === "family"),
  special: SPONSORS.filter((s) => s.tier === "special"),
};

const hasSponsors = SPONSORS.length > 0;

// Special Thanks: the partner groups, in the order they appear on the page.
// A heading with nobody under it drops out on its own.
const partnerGroups = (
  [
    { key: "activities", label: "Activities & Attractions" },
    { key: "beer", label: "In the Beer Garden" },
    { key: "agency", label: "Park, Agency & Public Safety" },
  ] as const
)
  .map((g) => ({ ...g, members: PARTNERS.filter((pa) => pa.group === g.key) }))
  .filter((g) => g.members.length > 0);

const hasPartners = PARTNERS.length > 0;
const hasLineup = LINEUP.length > 0;

// ── Day-of derived values ──
// An anchor per act, so a row in the schedule grid can jump to that band's
// card further down the page.
const actSlug = (name: string) =>
  "act-" +
  name
    .toLowerCase()
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");

// "Wingspan Stage · Area 1" splits into a heading and a sub-heading.
const splitStage = (label: string) => {
  const [name, area] = label.split("\u00b7").map((x) => x.trim());
  return { name: name || label, area: area || "" };
};
// "Wingspan Stage" reads as "Wingspan" where space is tight
const shortStage = (label: string) =>
  splitStage(label).name.replace(/\s+stage$/i, "");

// The schedule grid is one column per stage, in the order the stages first
// appear in LINEUP (which is in set-time order), so the column order
// follows the printed schedule without being hard-coded.
const stageColumns = LINEUP.reduce<{ name: string; acts: typeof LINEUP }[]>(
  (cols, act) => {
    const stage = act.stage || "Stage TBA";
    const col = cols.find((c) => c.name === stage);
    if (col) col.acts.push(act);
    else cols.push({ name: stage, acts: [act] });
    return cols;
  },
  [],
);

const keyTimes = [...KEY_TIMES].sort((a, b) => a.start.localeCompare(b.start));

// Turn a set time as it is written for people ("12:45 – 2:00 PM") into
// 24-hour start and end, so the browser can work out what is playing right
// now. A side with no AM/PM borrows it from the other side, which is how
// every set on this schedule is written.
const parseSetTime = (label?: string) => {
  if (!label) return null;
  const halves = label.split(/\s*[\u2013\u2014-]\s*/);
  if (halves.length !== 2) return null;
  const meridiem = (t: string) =>
    (t.match(/([ap])\.?m/i) || [])[1]?.toLowerCase();
  const fallback = meridiem(halves[1]) || meridiem(halves[0]);
  const to24 = (t: string) => {
    const m = t.match(/(\d{1,2}):(\d{2})/);
    if (!m) return null;
    let h = Number(m[1]);
    const mins = m[2];
    const ap = meridiem(t) || fallback;
    if (ap === "p" && h !== 12) h += 12;
    if (ap === "a" && h === 12) h = 0;
    return `${String(h).padStart(2, "0")}:${mins}`;
  };
  const start = to24(halves[0]);
  const end = to24(halves[1]);
  return start && end ? { start, end } : null;
};

// An open mic slot is written as "11:30 AM". Same 24-hour form as the sets.
const parseClockTime = (label: string) => {
  const m = label.match(/(\d{1,2}):(\d{2})\s*([ap])\.?m/i);
  if (!m) return null;
  let h = Number(m[1]);
  const ap = m[3].toLowerCase();
  if (ap === "p" && h !== 12) h += 12;
  if (ap === "a" && h === 12) h = 0;
  return `${String(h).padStart(2, "0")}:${m[2]}`;
};
const plusMinutes = (hm: string, mins: number) => {
  const [h, m] = hm.split(":").map(Number);
  const t = h * 60 + m + mins;
  return `${String(Math.floor(t / 60) % 24).padStart(2, "0")}:${String(
    t % 60,
  ).padStart(2, "0")}`;
};
// A slot runs until the next one starts; the last one gets the same half
// hour as the rest.
const openMicSlots = OPEN_MIC_SLOTS.flatMap((slot, i, all) => {
  const start = parseClockTime(slot.time);
  if (!start) return [];
  const following = all
    .slice(i + 1)
    .map((x) => parseClockTime(x.time))
    .find((x) => x && x > start);
  return [{ name: slot.name, start, end: following || plusMinutes(start, 30) }];
});
const openMicArea = AMENITIES.find((a) => a.id === "open-mic")?.area || "";

// What the browser needs to answer "what is on right now" without shipping
// the whole page's data: the sets in 24-hour time, the open mic slots, and
// the fixed moments.
const scheduleData = {
  date: EVENT_DATE.slice(0, 10),
  stages: stageColumns.map((c) => ({
    name: shortStage(c.name),
    area: splitStage(c.name).area,
  })),
  // a canceled act keeps its place in the lists but is never "on"
  sets: LINEUP.flatMap((act) => {
    const t = parseSetTime(act.time);
    if (!t || act.canceled) return [];
    return [
      {
        name: act.name,
        stage: shortStage(act.stage || ""),
        slug: actSlug(act.name),
        ...t,
      },
    ];
  }),
  openMic: { area: openMicArea, slots: openMicSlots },
  moments: keyTimes.map((k) => ({
    start: k.start,
    time: k.time,
    title: k.title,
    area: k.area || "",
  })),
};
const hasSchedule = hasLineup || keyTimes.length > 0;

// One chronological spine for the "By time" view: the sets, the open mic
// slots and the key times interleaved, each saying where it is. Rows that
// start together go key time, then sets, then the open mic, so "gates
// open" reads before the first set.
const prettyTime = (hm: string) => {
  const [h, m] = hm.split(":").map(Number);
  const ap = h >= 12 ? "PM" : "AM";
  return `${((h + 11) % 12) + 1}:${String(m).padStart(2, "0")} ${ap}`;
};
type TimelineKind = "set" | "openmic" | "keytime";
const kindOrder: Record<TimelineKind, number> = {
  keytime: 0,
  set: 1,
  openmic: 2,
};
const timeline = [
  ...LINEUP.flatMap((act) => {
    const t = parseSetTime(act.time);
    if (!t) return [];
    const st = splitStage(act.stage || "");
    return [
      {
        kind: "set" as TimelineKind,
        start: t.start,
        end: t.end,
        title: act.name,
        where: st.name,
        area: st.area,
        icon: "fa-music",
        href: `#${actSlug(act.name)}`,
        detail: "",
        canceled: !!act.canceled,
      },
    ];
  }),
  ...openMicSlots.map((slot) => ({
    kind: "openmic" as TimelineKind,
    start: slot.start,
    end: slot.end,
    title: slot.name,
    where: "Open Mic",
    area: openMicArea,
    icon: "fa-microphone-lines",
    href: "#pf-openmic",
    detail: "",
    canceled: false,
  })),
  ...keyTimes.map((k) => ({
    kind: "keytime" as TimelineKind,
    start: k.start,
    end: "",
    title: k.title,
    where: "",
    area: k.area || "",
    icon: k.icon,
    href: "",
    detail: k.detail || "",
    canceled: false,
  })),
].sort(
  (a, b) =>
    a.start.localeCompare(b.start) || kindOrder[a.kind] - kindOrder[b.kind],
);

// Food trucks, grouped by the area you would walk to.
const foodByArea = ([1, 2, 3] as const)
  .map((area) => ({
    area,
    trucks: FOOD_TRUCKS.filter((t) => t.area === area),
  }))
  .filter((g) => g.trucks.length > 0);

// The beer garden board, grouped under the four headings it uses.
const tapsByGroup = (
  [
    ["ale", "Ales"],
    ["ipa", "IPAs"],
    ["lager", "Lagers"],
    ["other", "Others"],
  ] as const
)
  .map(([key, label]) => ({
    key,
    label,
    taps: TAP_LIST.filter((t) => t.group === key),
  }))
  .filter((g) => g.taps.length > 0);

const hasWhosHere =
  FOOD_TRUCKS.length > 0 ||
  TAP_LIST.length > 0 ||
  CRAFT_VENDORS.length > 0 ||
  FIRST_RESPONDERS.length > 0;

// ── Winners ──
// Everything comes out of src/data/pondfest/winners.ts, the one file
// edited on event day. Nothing here can throw on a malformed line.
const raffleWinners = parseWinners(RAFFLE_WINNERS);
const auctionWinners = parseWinners(AUCTION_WINNERS);
const hasFiftyFifty = !!FIFTY_FIFTY_TICKET;
const hasWinners =
  WINNERS_LIVE &&
  (hasFiftyFifty || raffleWinners.length > 0 || auctionWinners.length > 0);

const hasMapViewer = EVENT_MAPS.length > 0;
const hasThanksGroups = THANKS_GROUPS.length > 0;
const phaseAttr = (phases?: Phase[]) => phases?.join(" ") || undefined;

// Is the merch pre-sale still open? Decided at build time here, and again in
// the browser (see applyPresaleDeadline below) so the buttons disappear on
// the deadline itself rather than at the next deploy.
const presaleOpen =
  !!MERCH_URL &&
  (!MERCH_PRESALE_DEADLINE ||
    new Date(MERCH_PRESALE_DEADLINE).getTime() > Date.now());

// Hero CTAs. Deliberately only the two that are not offered anywhere else:
// Volunteer, Sponsor, Vend and Perform all have their own cards in "Get
// Involved", and repeating them here only made the hero taller on a phone.
// Entries without a link are dropped rather than rendered disabled — the
// hero never shows a dead button.
const ctaLinks = [
  {
    label: "Donate",
    url: PONDFEST_DONATE_URL,
    style: "pf-btn--primary",
    icon: "fa-circle-dollar-to-slot",
    presale: false,
  },
  {
    label: "Pre-Order Merch",
    url: MERCH_URL,
    style: "pf-btn--outline-light",
    icon: "fa-shirt",
    presale: true, // dropped once the pre-sale deadline passes
  },
].filter((cta) => cta.url && (!cta.presale || presaleOpen));

// "Plan Your Visit" info notes — order matters, fees first
const planNotes = [
  { icon: "fa-ticket", text: FEE_NOTE },
  { icon: "fa-square-parking", text: PARKING_NOTES },
  { icon: "fa-bus", text: SHUTTLE_INFO },
  { icon: "fa-dog", text: DOG_NOTE },
  { icon: "fa-bag-shopping", text: BRING_NOTE },
  { icon: "fa-cloud-rain", text: RAIN_DATE_NOTE },
].filter((n) => n.text);

const involvedPaths = [
  {
    icon: "fa-hand-holding-heart",
    title: "Volunteer",
    desc: "Help make Pond Fest happen. We need hands for setup, Junior Jam, info tables, and more.",
    url: VOLUNTEER_URL,
    cta: "Sign Up to Volunteer",
  },
  {
    icon: "fa-guitar",
    title: "Perform",
    desc: "Are you a local musician or performer? We want to hear from you.",
    useEmailModal: true,
    cta: "Apply to Perform",
  },
  {
    icon: "fa-store",
    title: "Vend",
    desc: "Bring your business or craft to Pond Fest and connect with the community.",
    url: VENDOR_URL,
    cta: "Apply to Vend",
  },
  {
    icon: "fa-star",
    title: "Sponsor",
    desc: "Support the park and get visibility with thousands of attendees.",
    url: SPONSOR_URL,
    cta: "Become a Sponsor",
  },
];

// ── Page navigation ──
// One list feeds the quick-links row under the hero and the jump sheet. A
// section whose content is empty drops out on its own, so an early-in-the-
// year page with no lineup yet never offers a dead link. `phases` says when
// an entry is shown; the week of the event the recruiting rows give way to
// the schedule, the map and the food, which is what people are looking for.
const navSections: NavSection[] = (
  [
    {
      href: "#pf-thankyou",
      label: "Thank you",
      icon: "fa-heart",
      phases: ["afterglow"],
    },
    {
      href: "#pf-winners",
      label: "Winners",
      icon: "fa-trophy",
      phases: ["event", "afterglow"],
      show: hasWinners,
    },
    {
      href: "#pf-schedule",
      label: "Schedule",
      icon: "fa-clock",
      phases: ["prep", "event"],
      show: hasSchedule,
    },
    { href: "#pf-plan", label: "Plan Your Visit", icon: "fa-map" },
    {
      href: "#pf-fundraising",
      label: "Fundraising",
      icon: "fa-bullseye",
      phases: ["prep", "afterglow"],
      show: FUNDING_GOALS.length > 0,
    },
    {
      href: "#pf-expect",
      label: "What to Expect",
      icon: "fa-tent-arrow-turn-left",
    },
    {
      href: "#pf-whos-here",
      label: "Food & Drink",
      icon: "fa-utensils",
      phases: ["prep", "event"],
      show: hasWhosHere,
    },
    {
      href: "#pf-merch",
      label: "Merch",
      icon: "fa-shirt",
      show: MERCH_ITEMS.length > 0,
    },
    {
      href: "#pf-lineup",
      label: hasSchedule ? "Meet the Bands" : "Music Lineup",
      icon: "fa-music",
      show: hasLineup,
    },
    {
      href: "#pf-involved",
      label: "Get Involved",
      icon: "fa-hand-holding-heart",
      phases: ["prep"],
    },
    {
      href: "#pf-sponsors",
      label: "Sponsors & Thanks",
      icon: "fa-star",
      show: hasSponsors,
    },
    {
      href: "#pf-next",
      label: "Before you go",
      icon: "fa-comment-dots",
      phases: ["event"],
    },
    { href: "#pf-follow", label: "Follow & share", icon: "fa-share-nodes" },
    { href: "#pf-faq", label: "FAQ", icon: "fa-circle-question" },
    {
      href: RAFFLE_LINK,
      label: "Raffle",
      icon: "fa-ticket",
      phases: ["event"],
      show: !!RAFFLE_LINK,
    },
    {
      href: AUCTION_LINK,
      label: "Silent Auction",
      icon: "fa-gavel",
      phases: ["event"],
      show: !!AUCTION_LINK,
    },
    {
      href: FEEDBACK_LINK,
      label: "Take the survey",
      icon: "fa-square-poll-horizontal",
      phases: ["afterglow"],
      show: !!FEEDBACK_LINK,
    },
  ] as (NavSection & { show?: boolean })[]
).filter((s) => s.show !== false);

// The phone tab bar: the three or four things people look up most in each
// phase, plus a "More" button that opens the full list above.
const tabBar: NavSection[] = (
  [
    {
      href: "#pf-expect",
      label: "Expect",
      icon: "fa-tent-arrow-turn-left",
      phases: ["prep"],
    },
    { href: "#pf-plan", label: "Plan", icon: "fa-map", phases: ["prep"] },
    {
      href: "#pf-lineup",
      label: "Lineup",
      icon: "fa-music",
      phases: ["prep"],
      show: hasLineup,
    },
    {
      href: "#pf-involved",
      label: "Join in",
      icon: "fa-hand-holding-heart",
      phases: ["prep"],
    },
    {
      href: "#pf-winners",
      label: "Winners",
      icon: "fa-trophy",
      phases: ["event", "afterglow"],
      show: hasWinners,
    },
    {
      href: "#pf-schedule",
      label: "Schedule",
      icon: "fa-clock",
      phases: ["event"],
      show: hasSchedule,
    },
    { href: "#pf-plan", label: "Map", icon: "fa-map", phases: ["event"] },
    {
      href: "#pf-whos-here",
      label: "Food",
      icon: "fa-utensils",
      phases: ["event"],
      show: hasWhosHere,
    },
    {
      href: "#pf-thankyou",
      label: "Thanks",
      icon: "fa-heart",
      phases: ["afterglow"],
    },
    {
      href: "#pf-memories",
      label: "Photos",
      icon: "fa-images",
      phases: ["afterglow"],
    },
    {
      href: "#pf-sponsors",
      label: "Sponsors",
      icon: "fa-star",
      phases: ["afterglow"],
      show: hasSponsors,
    },
  ] as (NavSection & { show?: boolean })[]
).filter((s) => s.show !== false);

const tierLabels: Record<string, string> = {
  diamond: "Diamond Sponsors",
  platinum: "Platinum Sponsors",
  gold: "Gold Sponsors",
  silver: "Silver Sponsors",
  bronze: "Bronze Sponsors",
  family: "Family Sponsors",
  special: "Community Support",
};

// Photo credit for one amenity card. An unset `credit` means the house
// photographer; an empty string means we do not know and would rather say
// nothing than guess.
const amenityCredit = (a: (typeof AMENITIES)[number]) => {
  if (a.credit === undefined)
    return { name: PHOTO_CREDIT_NAME, url: PHOTO_CREDIT_URL };
  if (a.credit === "") return null;
  return { name: a.credit, url: a.creditUrl };
};

// Monogram fallback for acts with no photo — "The Sarah Koon Band" -> S
const monogram = (name: string) =>
  name
    .replace(/^the\s+/i, "")
    .charAt(0)
    .toUpperCase();

// Amenity links that point elsewhere on this page open in the same tab
const isOnPageLink = (url: string) => url.startsWith("#");

// The page's own address, for the Facebook share link and the caption
// people copy. The hashtags ride along in the caption, since that is the
// only way they reach an Instagram post from here.
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const shareBlurb = `Pond Fest ${CURRENT_YEAR} at Lums Pond State Park. ${HASHTAGS.join(
  " ",
)}`;
const shareCaption = `${shareBlurb} ${pageUrl}`;

// Every area tag on the page opens that area's map. "Area 2" opens the
// Area 2 map; anything spanning more than one ("Areas 1 & 2", "All three
// areas") opens the full map. Without a map viewer there is nothing to
// open, and the tags stay plain text.
const hasMapView = EVENT_MAPS.length > 0;
const mapForArea = (area: string) => {
  const m = area.match(/^Area (\d)$/);
  const id = m ? `area-${m[1]}` : "full";
  return EVENT_MAPS.some((x) => x.id === id) ? id : "full";
};

// Only a real web page gets a new tab. A "mailto:" opened in one leaves the
// reader staring at a blank tab, or at a URL their browser cannot handle.
const opensNewTab = (url: string) => /^https?:/i.test(url);

// Label the "hear more" button on an act card after wherever it points
const actLink = (url: string) => {
  const host = new URL(url).hostname.replace(/^www\./, "");
  if (host.includes("facebook"))
    return { icon: "fa-brands fa-facebook-f", label: "Facebook" };
  if (host.includes("instagram"))
    return { icon: "fa-brands fa-instagram", label: "Instagram" };
  if (host.includes("bandcamp"))
    return { icon: "fa-brands fa-bandcamp", label: "Bandcamp" };
  if (host.includes("youtube"))
    return { icon: "fa-brands fa-youtube", label: "YouTube" };
  if (host.includes("spotify"))
    return { icon: "fa-brands fa-spotify", label: "Spotify" };
  return { icon: "fa-solid fa-arrow-up-right-from-square", label: "Website" };
};

// Natural sizes for photos that do not sit in fixed-ratio boxes, so the
// browser reserves their space before they load and nothing jumps while
// someone scrolls. Measured from the files at build time.
const galleryPhotos = await Promise.all(
  GALLERY_PHOTOS.map(async (url) => ({ url, ...(await publicImageSize(url)) })),
);
const galleryPreview = galleryPhotos.slice(0, GALLERY_PREVIEW_COUNT);
const galleryMore = galleryPhotos.slice(GALLERY_PREVIEW_COUNT);

const merchItems = await Promise.all(
  MERCH_ITEMS.map(async (item) => ({
    ...item,
    ...(await publicImageSize(item.imageUrl)),
  })),
);
const hasMerch = merchItems.length > 0;
// The event map scales to the column width, so it needs its real size too.
const eventMapSize = EVENT_MAP_IMAGE_URL
  ? await publicImageSize(EVENT_MAP_IMAGE_URL)
  : {};
// The 75th strip sits above every section, so its logo must reserve its
// height too or the whole page shifts down when the logo arrives.
const seventyFifthLogoSize = await publicImageSize(SEVENTY_FIFTH_LOGO_WHITE);

// The maps and the sponsor ads are all different shapes, so each one needs
// its real pixel size to hold its space. Without it the program jumps around
// under the reader's thumb while the images stream in on park cell data.
const eventMaps = await Promise.all(
  EVENT_MAPS.map(async (m) => ({ ...m, ...(await publicImageSize(m.src)) })),
);
// Each ad takes its tier from the sponsor list, and the rail runs in tier
// order, biggest first, before any size treatment: half the hierarchy is
// which ad you see first. An ad whose sponsor is not in SPONSORS sits last.
const tierOrder: SponsorTier[] = [
  "diamond",
  "platinum",
  "gold",
  "silver",
  "bronze",
  "family",
  "special",
];
const adTier = (sponsor: string): SponsorTier =>
  SPONSORS.find((sp) => sp.name === sponsor)?.tier || "special";
const sponsorAds = (
  await Promise.all(
    SPONSOR_ADS.map(async (ad, i) => ({
      ...ad,
      order: i,
      tier: adTier(ad.sponsor),
      size: SPONSOR_AD_SIZES[adTier(ad.sponsor)],
      thumb: `/pondfest/ads/${ad.slug}-thumb.webp`,
      fullSrc: `/pondfest/ads/${ad.slug}.webp`,
      ...(await publicImageSize(`/pondfest/ads/${ad.slug}-thumb.webp`)),
    })),
  )
).sort(
  (a, b) =>
    tierOrder.indexOf(a.tier) - tierOrder.indexOf(b.tier) || a.order - b.order,
);
