          HEART_OF_PARKS_VIDEO_URL ? (
            <figure class="pf-75th-figure">
              <PondFestVideo
                src={HEART_OF_PARKS_VIDEO_URL}
                poster={HEART_OF_PARKS_POSTER_URL}
                captions={HEART_OF_PARKS_CAPTIONS_URL}
                label="Heart of the Parks: Bryan Mey on 75 years of Delaware State Parks"
              />
              <figcaption>
                FOLP President Bryan Mey on what 75 years means for Lums Pond,
                from Delaware State Parks' <em>Heart of the Parks</em> series.
              </figcaption>
            </figure>
          ) : (
            <div class="pf-img-placeholder">
              <i class="fa-solid fa-film" />
            </div>
          )
        }
      </div>
      <div class="pf-split-text pf-75th-text">
        <img
          class="pf-75th-corner-logo"
          src={SEVENTY_FIFTH_LOGO_WHITE}
          alt="Delaware State Parks 75th anniversary"
          width="160"
          loading="lazy"
        />
        <h2>75 Years of Delaware State Parks</h2>
        <p>
          Delaware State Parks turns 75 in 2026, and Pond Fest is proud to be
          part of the celebration. Since 1951, these parks have protected the
          places Delawareans love, including our own Lums Pond, home of the
          state's largest freshwater pond. Most people don't realize Delaware's
          state parks are roughly 65% self-funded. Entrance fees, programs, and
          community support keep them running, which is why a Friends group, and
          a festival like this one, matter.
        </p>
        {
          SEVENTY_FIFTH_URL && (
            <a
              class="pf-75th-link"
              href={SEVENTY_FIFTH_URL}
              target="_blank"
              rel="noopener"
            >
              Explore 75 years of Delaware State Parks →
            </a>
          )
        }
      </div>
    </div>
  </section>

  <!-- ══ GET INVOLVED ═══════════════════════════════════════════════ -->
  <section
    class="pf-section pf-section--dark pf-section--lazy"
    id="pf-involved"
    data-phase="prep"
  >
    <div class="pf-section-inner pf-section-inner--mid">
      <div class="pf-involved-header">
        <h2>Get Involved</h2>
      </div>
      <div class="pf-involved-grid">
        {
          involvedPaths.map((path) => (
            <div class="pf-involved-card">
              <i class={`fa-solid ${path.icon} pf-involved-icon`} />
              <h3>{path.title}</h3>
              <p>{path.desc}</p>
              {"useEmailModal" in path && path.useEmailModal ? (
                <button
                  type="button"
                  class="pf-btn pf-btn--outline-light"
                  data-open-modal="performModal"
                >
                  {path.cta}
                </button>
              ) : "url" in path && path.url ? (
                <a
                  href={path.url}
                  class="pf-btn pf-btn--outline-light"
                  target="_blank"
                  rel="noopener"
                >
                  {path.cta}
                </a>
              ) : (
                <span class="pf-btn pf-btn--disabled">
                  {path.cta} (Coming Soon)
                </span>
              )}
            </div>
          ))
        }
      </div>
      <div class="pf-involved-more">
        <a href="/pondfest/involved" class="pf-btn pf-btn--primary">
          Learn More About Getting Involved
        </a>
      </div>
    </div>
  </section>

  <!-- ══ SPONSORS ═══════════════════════════════════════════════════ -->
  <section
    class="pf-section pf-section--light pf-section--lazy"
    id="pf-sponsors"
  >
    <div class="pf-section-inner pf-section-inner--mid pf-sponsors-inner">
      <h2>Sponsors</h2>
      {
        hasSponsors ? (
          <>
            <div class="pf-sponsor-tiers">
              {(
                [
                  "diamond",
                  "platinum",
                  "gold",
                  "silver",
                  "bronze",
                  "family",
                  "special",
                ] as const
              ).map(
                (tier) =>
                  sponsorsByTier[tier].length > 0 && (
                    <div class="pf-sponsor-tier" data-tier={tier}>
                      <h3 class="pf-sponsor-tier-label">{tierLabels[tier]}</h3>
                      <div class="pf-sponsor-list">
                        {sponsorsByTier[tier].map((s) =>
                          s.url ? (
                            <a
                              href={s.url}
                              target="_blank"
                              rel="noopener"
                              class="pf-sponsor-name"
                            >
                              {s.name}
                            </a>
                          ) : (
                            <span class="pf-sponsor-name">{s.name}</span>
                          ),
                        )}
                      </div>
                    </div>
                  ),
              )}
            </div>
            {sponsorAds.length > 0 && (
              <div class="pf-ads" id="pf-ads">
                <h3 class="pf-ads-title">From our sponsors</h3>
                <p class="pf-ads-sub">
                  Tap one to read it full size. These businesses and
                  organizations paid for Pond Fest; give them a second.
                </p>
                <ul class="pf-ads-rail">
                  {sponsorAds.map((ad) => (
                    <li
                      class={`pf-ad--${ad.size}`}
                      data-tier={ad.tier}
                      data-shape={
                        ad.width && ad.height && ad.height > ad.width
                          ? "tall"
                          : "wide"
                      }
                    >
                      <a
                        class="pf-ad"
                        href={ad.fullSrc}
                        target="_blank"
                        rel="noopener"
                        data-pf-ad
                        data-pf-ad-caption={ad.sponsor}
                      >
                        <img
                          src={ad.thumb}
                          alt={ad.alt}
                          width={ad.width}
                          height={ad.height}
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="pf-ad-name">{ad.sponsor}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {OUT_AND_ABOUT_URL && (
              <a
                class="pf-press-card"
                href={OUT_AND_ABOUT_URL}
                target="_blank"
                rel="noopener"
              >
                <i class="fa-solid fa-newspaper" aria-hidden="true" />
                <span>
                  <strong>Pond Fest in Out &amp; About</strong>
                  <span class="pf-press-sub">{OUT_AND_ABOUT_LABEL}</span>
                </span>
                <i
                  class="fa-solid fa-arrow-up-right-from-square pf-press-arrow"
                  aria-hidden="true"
                />
              </a>
            )}

            <p class="pf-sponsor-cta" data-phase="prep">
              {SPONSOR_URL ? (
                <a href={SPONSOR_URL} target="_blank" rel="noopener">
                  Become a sponsor
                </a>
              ) : (
                <a href={`mailto:${PONDFEST_EMAIL}`}>Become a sponsor</a>
              )}{" "}
              and put your name on the biggest Pond Fest yet.
            </p>
          </>
        ) : (
          <div class="pf-sponsor-empty">
            <p>
              Interested in sponsoring Pond Fest {CURRENT_YEAR}?{" "}
              {SPONSOR_URL ? (
                <a href={SPONSOR_URL} target="_blank" rel="noopener">
                  Fill out our sponsor interest form
                </a>
              ) : (
                <>
                  Reach out to{" "}
                  <a href={`mailto:${PONDFEST_EMAIL}`}>{PONDFEST_EMAIL}</a>
                </>
              )}
            </p>
          </div>
        )
      }
    </div>
  </section>

  <!-- ══ SPECIAL THANKS ════════════════════════════════════════════ -->
  {
    (hasPartners || hasThanksGroups || EAGLE_SCOUT_NOTE) && (
      <section
        class="pf-section pf-section--purple pf-section--lazy"
        id="pf-thanks"
      >
        <div class="pf-section-inner pf-section-inner--mid pf-thanks-inner">
          <h2>Special Thanks</h2>
          {hasPartners && <p class="pf-thanks-intro">{PARTNERS_INTRO}</p>}
          <div class="pf-thanks-groups">
            {partnerGroups.map((g) => (
              <div class="pf-thanks-group" data-group={g.key}>
                <h3 class="pf-thanks-group-label">{g.label}</h3>
                <ul class="pf-thanks-list">
                  {g.members.map((partner) => (
                    <li class="pf-thanks-item">
                      {partner.url ? (
                        <a
                          href={partner.url}
                          target="_blank"
                          rel="noopener"
                          class="pf-thanks-name"
                        >
                          {partner.name}
                        </a>
                      ) : (
                        <span class="pf-thanks-name">{partner.name}</span>
                      )}
                      {partner.what && (
                        <span class="pf-thanks-what">{partner.what}</span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>

          {hasThanksGroups && (
            <div class="pf-people">
              <h3 class="pf-people-heading">And the people</h3>
              <div class="pf-people-groups">
                {THANKS_GROUPS.map((g) => (
                  <div
                    class:list={[
                      "pf-people-group",
                      g.names.length > 12 && "pf-people-group--long",
                    ]}
                  >
                    <h4>
                      <i class={`fa-solid ${g.icon}`} aria-hidden="true" />{" "}
                      {g.title}
                    </h4>
                    {g.intro && <p class="pf-people-intro">{g.intro}</p>}
                    {g.names.length > 0 && (
                      <ul class="pf-people-list">
                        {g.names.map((n) => (
                          <li>{n}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}

          {EAGLE_SCOUT_NOTE && (
            <div class="pf-eagle">
              <i class="fa-solid fa-award" aria-hidden="true" />
              <div>
                <strong>New benches at the pickleball courts</strong>
                <p>{EAGLE_SCOUT_NOTE}</p>
              </div>
            </div>
          )}
        </div>
      </section>
    )
  }

  <!-- ══ FAQ — 2-column on desktop ═════════════════════════════════ -->
  <section class="pf-section pf-section--dark pf-section--lazy" id="pf-faq">
    <div class="pf-section-inner pf-faq-layout">
      <div class="pf-faq-intro">
        <h2>Frequently Asked Questions</h2>
        <p>
          Everything you need to know about Pond Fest. Can't find your answer?
          Email <a href={`mailto:${PONDFEST_EMAIL}`}>{PONDFEST_EMAIL}</a>
        </p>
        <p class="pf-press-link">
          Writing about Pond Fest, or promoting it as a sponsor, vendor, or
          performer? <a href="/pondfest/press">Press &amp; media kit →</a>
        </p>
      </div>
      <div class="pf-faq">
        {
          FAQ.map((item, i) => (
            <div
              class="pf-faq-item"
              id={`faq-${i}`}
              data-phase={phaseAttr(item.phases)}
            >
              <button
                class="pf-faq-button"
                type="button"
                aria-expanded="false"
                aria-controls={`faq-content-${i}`}
                id={`faq-btn-${i}`}
              >
                <span>{item.question}</span>
                <svg
                  class="pf-faq-chevron"
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                >
                  <path
                    fill="none"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="m6 9l6 6l6-6"
                  />
                </svg>
              </button>
              <div
                id={`faq-content-${i}`}
                aria-labelledby={`faq-btn-${i}`}
                class="pf-faq-content"
              >
                <p>{item.answer}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ══ FEST MEMORIES ════════════════════════════════════════════ -->
  <section
    class="pf-section pf-section--purple pf-section--lazy pf-memories-section"
    id="pf-memories"
  >
    <div class="pf-section-inner pf-memories-header">
      <h2>Fest Memories</h2>
    </div>
    {
      galleryPhotos.length > 0 ? (
        <>
          <div
            class="pf-gallery-masonry"
            aria-label="Pond Fest photo gallery"
            id="pf-gallery"
          >
            {galleryPreview.map((photo, i) => (
              <div class="pf-gallery-item">
                <img
                  src={photo.url}
                  alt={`Pond Fest memory ${i + 1}`}
                  width={photo.width}
                  height={photo.height}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ))}
            {galleryMore.map((photo, i) => (
              <div class="pf-gallery-item" data-pf-gallery-more hidden>
                <img
                  src={photo.url}
                  alt={`Pond Fest memory ${galleryPreview.length + i + 1}`}
                  width={photo.width}
                  height={photo.height}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ))}
          </div>
          {galleryMore.length > 0 && (
            <div class="pf-gallery-more">
              <button
                type="button"
                class="pf-btn pf-btn--outline-light"
                data-pf-gallery-toggle
                aria-controls="pf-gallery"
                aria-expanded="false"
              >
                <i class="fa-solid fa-images" aria-hidden="true" />
                Show {galleryMore.length} more photos
              </button>
            </div>
          )}
        </>
      ) : (
        <div
          class="pf-gallery-masonry pf-gallery-masonry--placeholder"
          aria-label="Pond Fest photo gallery"
        >
          {[...Array(8)].map((_, i) => (
            <div class="pf-gallery-item">
              <div class="pf-img-placeholder">
                <i class="fa-solid fa-camera" />
              </div>
            </div>
          ))}
        </div>
      )
    }
    {
      PHOTO_CREDIT_NAME && (
        <p class="pf-photo-credit">
          Event photography by{" "}
          {PHOTO_CREDIT_URL ? (
            <a href={PHOTO_CREDIT_URL} target="_blank" rel="noopener">
              {PHOTO_CREDIT_NAME}
            </a>
          ) : (
            PHOTO_CREDIT_NAME
          )}
        </p>
      )
    }
  </section>

  <!-- ══ BEFORE YOU GO — survey, membership, next year's date ═══════ -->
  <PondFestNext id="pf-next" phases={["event"]} variant="event" />

  <!-- ══ FOLLOW & SHARE — the hashtags, the phone's share sheet, and where
       to find us the rest of the year. Neither Facebook nor Instagram will
       take a caption from a link, so the caption is copied, not sent. ═══ -->
  <section
    class="pf-section pf-section--light pf-section--lazy"
    id="pf-follow"
    data-pf-blurb={shareBlurb}
    data-pf-caption={shareCaption}
  >
    <div class="pf-section-inner pf-section-inner--narrow pf-follow-inner">
      <h2>Follow &amp; share</h2>
      <p class="pf-follow-lead">
        Tag your photos so we can find them. Facebook and Instagram will not
        take a caption from a web page, so copy it here and paste it there.
      </p>
      <p class="pf-follow-tags">{HASHTAGS.join(" ")}</p>
      <div class="pf-follow-actions">
        <button
          type="button"
          class="pf-btn pf-btn--purple"
          data-pf-share
          hidden
        >
          <i class="fa-solid fa-share-nodes" aria-hidden="true"></i> Share this
          page
        </button>
        <button type="button" class="pf-btn pf-btn--outline-dark" data-pf-copy>
          <i class="fa-solid fa-copy" aria-hidden="true"></i>
          <span data-pf-copy-label>Copy caption</span>
        </button>
        <a
          class="pf-btn pf-btn--outline-dark"
          href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(
            pageUrl,
          )}`}
          target="_blank"
          rel="noopener"
        >
          <i class="fa-brands fa-facebook" aria-hidden="true"></i> Share on
          Facebook
        </a>
      </div>
      <p class="pf-follow-also">Follow along the rest of the year:</p>
      <div class="pf-follow-links">
        <a href={FACEBOOK_URL} target="_blank" rel="noopener">
          <i class="fa-brands fa-facebook" aria-hidden="true"></i> Facebook
        </a>
        <a href={INSTAGRAM_URL} target="_blank" rel="noopener">
          <i class="fa-brands fa-instagram" aria-hidden="true"></i> Instagram
        </a>
      </div>
    </div>
  </section>

  <!-- ══ HISTORY TEASER ═════════════════════════════════════════════ -->
  <section
    class="pf-section pf-section--dark pf-section--lazy pf-history-section"
    style={HISTORY_BG_PHOTO
      ? `background-image: url('${HISTORY_BG_PHOTO}')`
      : undefined}
  >
    <div class="pf-section-inner pf-section-inner--narrow pf-history-inner">
      <h2>Our History</h2>
      <div class="pf-history-stats">
        <div class="pf-history-stat">
          <span class="pf-history-stat-num">2</span>
          <span class="pf-history-stat-label">Years</span>
        </div>
        <span class="pf-history-stat-dot">&middot;</span>
        <div class="pf-history-stat">
          <span class="pf-history-stat-num">$30K</span>
          <span class="pf-history-stat-label">Generated</span>
        </div>
        <span class="pf-history-stat-dot">&middot;</span>
        <div class="pf-history-stat">
          <span class="pf-history-stat-num">2,100+</span>
          <span class="pf-history-stat-label">Attendees</span>
        </div>
      </div>
      <p>
        Pond Fest launched in 2024 and has grown into one of Delaware's favorite
        community outdoor festivals.
      </p>
      <a href="/pondfest/archive" class="pf-btn pf-btn--outline-light">
        View All Past Events
      </a>
    </div>
  </section>

  <section
    class="pf-section pf-section--purple pf-section--lazy pf-disclosure"
  >
    <div class="pf-section-inner pf-section-inner--mid">
      <h2 class="pf-disclosure-title">{SUPPORT_DISCLOSURE_TITLE}</h2>
      {SUPPORT_DISCLOSURE.map((para) => <p>{para}</p>)}
      <p>
        Questions about this, or about who supports Pond Fest? Email{" "}
        <a href={`mailto:${PONDFEST_EMAIL}`}>{PONDFEST_EMAIL}</a>.
      </p>
    </div>
  </section>

  <EmailCTAModal
    id="performModal"
    title="Apply to Perform at Pond Fest"
    intro="We'd love to hear from you. Send a quick note about who you are, your genre, and where we can listen, and the lineup team will get back to you."
    email={PONDFEST_EMAIL}
    subject="Pond Fest Performer Interest"
  />

  <!-- Full-size sponsor ad, opened from the rail in the Sponsors section -->
  <div
    class="pf-lightbox"
    id="pf-lightbox"
    role="dialog"
    aria-modal="true"
    aria-label="Sponsor advertisement"
    hidden
  >
    <div class="pf-lightbox-bar">
      <span class="pf-lightbox-caption" data-pf-lightbox-caption></span>
      <button
        type="button"
        class="pf-lightbox-close"
        data-pf-lightbox-close
        aria-label="Close"
      >
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
    </div>
    <div class="pf-lightbox-body">
      <img alt="" decoding="async" />
    </div>
  </div>

  <!-- Map quick view, opened from any area tag on the page -->
  {
    hasMapViewer && (
      <div
        class="pf-lightbox pf-mapbox"
        id="pf-mapbox"
        role="dialog"
        aria-modal="true"
        aria-label="Map"
        hidden
      >
        <div class="pf-lightbox-bar">
          <span class="pf-lightbox-caption" data-pf-mapbox-title />
          <button
            type="button"
            class="pf-lightbox-close"
            data-pf-mapbox-close
            aria-label="Close"
          >
            <i class="fa-solid fa-xmark" aria-hidden="true" />
          </button>
        </div>
        <div class="pf-lightbox-body">
          <img alt="" decoding="async" />
        </div>
        <div class="pf-mapbox-foot">
          <p class="pf-mapbox-note" data-pf-mapbox-note />
          <div class="pf-mapbox-links">
            <a
              class="pf-mapbox-link"
              data-pf-mapbox-full
              href="#pf-mapview"
              target="_blank"
              rel="noopener"
            >
              <i class="fa-solid fa-magnifying-glass-plus" aria-hidden="true" />{" "}
              Open the full-size map
            </a>
            <a class="pf-mapbox-link" data-pf-mapbox-all href="#pf-mapview">
              <i class="fa-solid fa-map" aria-hidden="true" /> All the maps
            </a>
          </div>
        </div>
      </div>
    )
  }

  <PondFestSectionNav
    sections={navSections}
    tabs={tabBar}
    donateUrl={PONDFEST_DONATE_URL}
  />
</Layout>

<style>
  /* Everything this page toggles with the hidden attribute (gallery extras,
     the pre-sale buttons) has its own display value, which would otherwise
     win over the stylesheet reset's [hidden] rule. */
  [hidden] {
    display: none !important;
  }

  /* ── Hero ── */
  .pf-hero {
    background-image: var(--pf-hero-img);
    /* min-height only. The overlay below is in normal flow, so on a narrow
       screen the content pushes this section open instead of spilling out
       of a fixed box and over the header. */
    min-height: max(85vh, 780px);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    position: relative;
    display: flex;
    align-items: center;
  }
  @media (max-width: 768px) {
    .pf-hero {
      background-image: var(--pf-hero-img-sm, var(--pf-hero-img));
    }
  }
  /* On event day the hero is a band, not a billboard: the name, the date
     and the place, enough to confirm you scanned the right sign, with the
     quick links right under it. No photo either; a short band does not
     need 285 KB on the critical path. */
  :global([data-pf-phase="event"]) .pf-hero {
    min-height: 0;
    background-image: linear-gradient(
      160deg,
      var(--pf-purple-dark),
      var(--pf-purple)
    );
  }
  :global([data-pf-phase="event"]) .pf-hero::before {
    display: none;
  }
  :global([data-pf-phase="event"]) .pf-hero-overlay {
    padding: clamp(1.1rem, 3vw, 2rem) clamp(1.5rem, 5vw, 5rem);
  }
  :global([data-pf-phase="event"]) .pf-hero-title {
    font-size: clamp(3rem, 12vw, 7rem);
    margin-bottom: 0.15em;
  }
  :global([data-pf-phase="event"]) .pf-hero-meta {
    line-height: 1.5;
    margin-bottom: 0;
  }
  /* the countdown's day-of line sits in the band too; keep it tight */
  :global([data-pf-phase="event"]) .pf-hero :global(.pf-today-message) {
    padding: 0;
  }
  :global([data-pf-phase="event"]) .pf-hero :global(.pf-today-message p) {
    margin: 0.5rem 0 0;
  }
  .pf-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(11, 9, 23, 0.7) 0%,
      rgba(11, 9, 23, 0.85) 100%
    );
  }
  .pf-hero-overlay {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(2.5rem, 7vw, 4rem) clamp(1.5rem, 5vw, 5rem);
    box-sizing: border-box;
  }
  .pf-hero-content {
    text-align: center;
    color: #fff;
    max-width: 860px;
    width: 100%;
  }
  .pf-hero-eyebrow {
    font-size: clamp(0.7rem, 1.5vw, 0.85rem);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    opacity: 0.75;
    margin-bottom: 0.5rem;
    display: block;
  }
  .pf-hero-title {
    font-family: var(--font-header);
    font-size: clamp(3.5rem, 14vw, 9rem);
    line-height: 0.92;
    color: #fff;
    margin: 0 0 0.25em 0;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.5);
    letter-spacing: 0.02em;
  }
  .pf-hero-year {
    color: var(--pf-teal-light);
  }
  .pf-hero-meta {
    font-size: clamp(0.88rem, 2vw, 1.05rem);
    opacity: 0.85;
    margin-bottom: 0.4rem;
    line-height: 1.7;
  }
  .pf-hero-meta i {
    opacity: 0.6;
    margin-right: 0.25em;
  }
  /* keep the date, the time and the location each in one piece, so a narrow
     screen never strands "PM" on a line of its own */
  .pf-nowrap {
    white-space: nowrap;
  }
  /* on a phone the date and the time each take their own line, so the
     separator between them has nothing left to separate */
  @media (max-width: 480px) {
    .pf-hero-meta-sep {
      display: none;
    }
    .pf-hero-meta .pf-nowrap {
      display: block;
    }
    /* the spans are their own lines now, so the explicit break would
       leave a blank one */
    .pf-hero-meta br {
      display: none;
    }
  }
  /* 75th anniversary strip — deliberately quiet, and out of the hero so the
     hero does not have to carry it on a phone */
  .pf-75th-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    flex-wrap: wrap;
    background: var(--pf-dark);
    padding: clamp(1rem, 3vw, 1.4rem) clamp(1.5rem, 5vw, 5rem);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }
  .pf-75th-strip img {
    width: 100%;
    max-width: 120px;
    height: auto;
    display: block;
    opacity: 0.9;
  }
  .pf-75th-strip span {
    font-size: clamp(0.68rem, 1.5vw, 0.8rem);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.6);
    text-align: center;
  }
  .pf-75th-strip:hover span {
    color: rgba(255, 255, 255, 0.85);
  }
  .pf-hero-tagline {
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    opacity: 0.8;
    font-style: italic;
    margin-bottom: 0.5rem;
  }
  .pf-hero-free {
    font-size: clamp(0.82rem, 1.6vw, 0.95rem);
    font-weight: 700;
    color: var(--pf-teal-light);
    margin: 0 0 1rem;
    line-height: 1.5;
  }
  .pf-hero-event {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin-top: 1.1rem;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  .pf-hero-event:hover,
  .pf-hero-event:focus-visible {
    color: #fff;
    border-bottom-color: #fff;
  }
  .pf-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
    margin-top: 1.5rem;
  }
  @media (max-width: 480px) {
    .pf-hero-ctas {
      flex-direction: column;
      align-items: center;
      margin-top: 1.25rem;
    }
    .pf-hero-ctas .pf-btn {
      width: 100%;
      max-width: 300px;
    }
    .pf-hero-title {
      font-size: clamp(3rem, 13vw, 4.5rem);
    }
    .pf-hero-tagline {
      margin-bottom: 0.35rem;
    }
    .pf-hero-free {
      margin-bottom: 0.5rem;
    }
  }
  @media (min-width: 768px) {
    .pf-hero-title {
      white-space: nowrap;
    }
  }

  /* ── Alert banner ── */
  .pf-alert-banner {
    background-color: #e76f00;
    color: #fff;
    text-align: center;
    padding: 0.65rem 1.25rem;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .pf-alert-banner i {
    margin-right: 0.4em;
  }

  /* ── Day-of panel ── */
  .pf-dayof-quicknav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
  }
  .pf-quicknav-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.6rem 1.1rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s;
  }
  .pf-quicknav-btn:hover {
    background: rgba(255, 255, 255, 0.22);
    color: #fff;
  }
  .pf-dayof-link-cards {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .pf-dayof-link-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    text-decoration: none;
    color: #fff;
    transition: background 0.15s;
  }
  .pf-dayof-link-card:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }
  .pf-dayof-link-card > div {
    flex: 1;
  }
  .pf-dayof-link-card strong {
    display: block;
    font-size: 1rem;
    margin-bottom: 0.1rem;
  }
  .pf-dayof-link-card p {
    margin: 0;
    font-size: 0.85rem;
    opacity: 0.7;
  }
  .pf-dayof-link-icon {
    font-size: 1.3rem;
    color: var(--pf-teal);
    flex-shrink: 0;
  }
  .pf-dayof-link-arrow {
    color: rgba(255, 255, 255, 0.3);
    flex-shrink: 0;
  }
  .pf-feedback-section {
    text-align: center;
  }
  .pf-feedback-section p {
    max-width: 540px;
    margin: 0 auto 1.25rem auto;
  }

  /* ── Plan Your Visit ── */
  .pf-plan-header {
    text-align: center;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .pf-maps-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    margin-bottom: 1.25rem;
  }
  /* The event map is the day-of program — give it the full width */
  .pf-map-item--event {
    grid-column: 1 / -1;
  }
  .pf-map-item {
    text-align: center;
  }
  .pf-map-item h3 {
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }
  .pf-map-item a {
    display: block;
    text-decoration: none;
  }
  .pf-map-img {
    width: 100%;
    height: auto;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .pf-map-item:not(.pf-map-item--event) .pf-map-img {
    object-fit: cover;
    max-height: 300px;
  }
  .pf-map-tap-hint {
    display: block;
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.5);
    margin-top: 0.3rem;
  }
  .pf-info-note {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    padding: 0.9rem 1.1rem;
    margin-top: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.9rem;
  }
  .pf-info-note i {
    color: var(--pf-teal);
    font-size: 1.1rem;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }
  .pf-info-note p {
    margin: 0;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.82);
  }
  .pf-plan-social {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  /* ── Follow & share ── */
  .pf-follow-inner {
    text-align: center;
  }
  .pf-follow-lead {
    max-width: 52ch;
    margin: 0 auto 0.9rem;
    font-size: clamp(0.98rem, 1.9vw, 1.1rem);
    line-height: 1.6;
  }
  .pf-follow-tags {
    margin: 0 0 1.4rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--pf-purple);
    font-size: 1.05rem;
  }
  .pf-follow-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }
  .pf-follow-actions [hidden] {
    display: none;
  }
  .pf-follow-also {
    margin: 1.75rem 0 0.6rem;
    font-size: 0.95rem;
  }
  .pf-follow-links {
    display: flex;
    justify-content: center;
    gap: 1.75rem;
  }
  .pf-follow-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-weight: 700;
    color: var(--pf-purple);
    text-decoration: none;
  }
  .pf-follow-links a i {
    font-size: 1.5rem;
  }
  .pf-follow-links a:hover,
  .pf-follow-links a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ── Fundraising Goals ── */
  .pf-goals-intro {
    text-align: center;
    margin-bottom: clamp(1.75rem, 3vw, 2.75rem);
  }
  .pf-goals-intro .pf-btn {
    margin-top: 0.75rem;
  }
  /* One alternating row per goal. The photo is capped rather than filling
     half the section, so a two-sentence goal does not get a 680px-tall
     picture standing next to it. */
  .pf-goals-split {
    max-width: 1080px;
    margin: clamp(2rem, 4vw, 3rem) auto 0;
    min-height: 0; /* the global floor is for full-bleed splits */
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .pf-goals-split .pf-split-media {
    width: 100%;
    max-width: 420px;
    aspect-ratio: 4 / 3;
    border-radius: 14px;
    justify-self: center;
  }
  .pf-goals-split .pf-split-text {
    padding: 0;
  }
  .pf-goals-split .pf-split-text p {
    margin-bottom: 1.25rem;
  }
  .pf-goals-split .pf-img-placeholder {
    min-height: 0;
  }
  .pf-goal-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }
  .pf-goal-more {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    color: var(--pf-teal-light);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid rgba(77, 217, 203, 0.4);
  }
  .pf-goal-more:hover,
  .pf-goal-more:focus-visible {
    border-bottom-color: var(--pf-teal-light);
  }
  .pf-goal-more i {
    font-size: 0.75em;
  }
  /* (the split rules below still dress the 75th anniversary section) */
  .pf-split-text h3 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    color: var(--pf-teal-light);
    margin-bottom: 1rem;
    font-weight: 700;
  }
  .pf-split-text p {
    font-size: clamp(0.95rem, 1.8vw, 1.1rem);
    line-height: 1.7;
    opacity: 0.88;
    margin-bottom: 1.5rem;
  }
  .pf-goals-donate-soon {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.45);
    font-style: italic;
  }

  /* ── What to Expect / amenity grid ── */
  .pf-expect-header {
    text-align: center;
    margin-bottom: clamp(2rem, 4vw, 3.25rem);
  }
  .pf-amen-intro {
    max-width: 720px;
    margin: 0 auto;
    font-size: clamp(0.95rem, 1.8vw, 1.1rem);
    line-height: 1.7;
  }

  /* Masonry, via multi-column rather than grid. The cards are wildly
     different heights — a two-line card next to a ten-line one — and a
     row-based grid sizes every row to its tallest card, which left a hole
     under each short one. Columns pack them tight instead.
     The trade-off: reading order runs down each column, not across. That is
     fine for a browse-it grid of things to do, but it is why the list order
     in AMENITIES no longer maps to a left-to-right reading of the page. */
  .pf-amen-grid {
    columns: 1;
    column-gap: clamp(2rem, 4vw, 3rem);
    max-width: 1180px;
    margin: 0 auto;
  }
  @media (min-width: 900px) {
    .pf-amen-grid {
      columns: 2;
      column-gap: clamp(2rem, 4vw, 3.5rem);
    }
  }
  @media (min-width: 1280px) {
    .pf-amen-grid {
      columns: 3;
    }
  }

  .pf-amen-card {
    display: flex;
    flex-direction: column;
    /* never let a card be split across two columns */
    break-inside: avoid;
    /* column-gap only handles the horizontal; this is the vertical one */
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .pf-amen-media {
    aspect-ratio: 3 / 2;
    border-radius: 14px;
    overflow: hidden;
    background: var(--pf-light-alt);
    margin-bottom: 1.1rem;
  }
  /* shorter photos on a phone, where twenty-two cards stack in one column */
  @media (max-width: 599px) {
    .pf-amen-media {
      aspect-ratio: 2 / 1;
    }
  }
  .pf-amen-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .pf-amen-media-link {
    display: block;
    height: 100%;
  }
  .pf-amen-card:hover .pf-amen-media img {
    transform: scale(1.03);
  }
  /* cards with no photo yet: a tile carrying the icon at poster size */
  .pf-amen-media--icon {
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(
      135deg,
      var(--pf-purple) 0%,
      var(--pf-purple-dark) 55%,
      #1c1638 100%
    );
    position: relative;
  }
  .pf-amen-media--icon::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 78% 22%,
      rgba(94, 200, 195, 0.35),
      transparent 55%
    );
  }
  /* a ring behind the glyph, so the tile still reads as a designed
     panel rather than an empty block */
  .pf-amen-media--icon::before {
    content: "";
    position: absolute;
    width: clamp(6.5rem, 15vw, 9.5rem);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.05);
  }
  .pf-amen-media--icon i {
    font-size: clamp(2.75rem, 6vw, 4rem);
    color: rgba(255, 255, 255, 0.92);
    position: relative;
    z-index: 1;
  }

  .pf-amen-body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .pf-amen-title {
    /* Block flow, not flex. As a flex container every child wrapped on its
       own line, and in a narrow column that stranded the icon on a line by
       itself above the title. Inline flow keeps the icon glued to the first
       word and lets a badge trail the last one. */
    display: block;
    font-size: clamp(1.15rem, 2.2vw, 1.5rem) !important;
    color: var(--pf-purple-dark) !important;
    margin: 0 !important;
    line-height: 1.25;
  }
  .pf-amen-title-icon {
    color: var(--pf-teal);
    font-size: 0.8em;
    margin-right: 0.45em;
  }
  .pf-amen-badge {
    padding: 0.15em 0.6em;
    border-radius: 999px;
    background: var(--pf-purple);
    color: #fff;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    white-space: nowrap;
    display: inline-block;
    margin-left: 0.45em;
    vertical-align: middle;
  }
  .pf-amen-desc {
    font-size: clamp(0.86rem, 1.4vw, 0.94rem);
    line-height: 1.6;
    color: #4a3d6b;
    margin: 0;
    max-width: 46ch;
  }
  /* Two lines, then "Show more". The attribute is set by script, and only
     on cards where the text overflows, so with nothing running the full
     text shows and a two-line card never grows a pointless button. */
  .pf-amen-desc[data-pf-clamp=""] {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  /* the button is made by script, so it needs :global() like the clock rows */
  .pf-amen-body :global(.pf-amen-more) {
    align-self: flex-start;
    margin: -0.15rem 0 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--pf-purple);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(61, 47, 122, 0.35);
  }
  .pf-amen-body :global(.pf-amen-more:hover),
  .pf-amen-body :global(.pf-amen-more:focus-visible) {
    text-decoration-color: currentColor;
  }
  .pf-amen-area {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45em;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--pf-purple);
    margin-top: 0.2rem;
  }
  .pf-amen-area i {
    color: var(--pf-teal);
    font-size: 0.9em;
  }
  /* An area tag that opens the map. Same type as the tag it replaces, with
     a border so it reads as something you can tap. */
  a.pf-area-chip {
    text-decoration: none;
    cursor: pointer;
  }
  a.pf-amen-area {
    border: 1px solid rgba(61, 47, 122, 0.3);
    border-radius: 999px;
    padding: 0.25em 0.7em;
    background: #fff;
    transition:
      background 0.15s,
      color 0.15s,
      border-color 0.15s;
  }
  a.pf-amen-area:hover,
  a.pf-amen-area:focus-visible {
    background: var(--pf-purple);
    border-color: var(--pf-purple);
    color: #fff;
  }
  a.pf-amen-area:hover i,
  a.pf-amen-area:focus-visible i {
    color: #fff;
  }

  /* ── the logistics strip under the grid ── */
  .pf-everywhere {
    background: #fff;
    border: 1px solid rgba(61, 47, 122, 0.14);
    border-radius: 12px;
    padding: clamp(1.1rem, 2.5vw, 1.75rem);
    margin: clamp(1rem, 2vw, 2rem) auto 0;
    max-width: 1180px;
  }
  .pf-everywhere-label {
    font-size: 0.72rem !important;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--pf-purple) !important;
    margin-bottom: 0.9rem !important;
  }
  .pf-everywhere-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem 1.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .pf-everywhere-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .pf-everywhere-list {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .pf-everywhere-list li {
    display: flex;
    align-items: baseline;
    gap: 0.6em;
    font-size: 0.9rem;
    color: #3a2e5a;
    line-height: 1.45;
  }
  .pf-everywhere-list i {
    color: var(--pf-teal);
    flex-shrink: 0;
  }
  .pf-amen-footnote {
    text-align: center;
    font-size: 0.9rem;
    margin: 1.25rem auto 0;
  }
  .pf-amen-footnote a {
    color: var(--pf-purple);
    font-weight: 700;
  }

  .pf-amen-figure {
    margin: 0 0 1.1rem;
  }
  .pf-amen-figure .pf-amen-media {
    margin-bottom: 0;
  }
  .pf-amen-credit {
    display: block;
    margin-top: 0.45rem;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: rgba(58, 46, 90, 0.6);
  }
  .pf-amen-credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .pf-amen-credit a:hover {
    color: var(--pf-purple);
  }
  .pf-amen-title-link {
    color: inherit;
    text-decoration: none;
    border-bottom: 2px solid var(--pf-teal);
  }
  .pf-amen-title-link:hover {
    color: var(--pf-purple);
  }
  .pf-amen-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1rem;
    margin: 0.1rem 0 0.55rem;
  }
  /* times are read, not shouted, so they opt out of the chip's caps */
  .pf-amen-time {
    color: var(--pf-purple-dark);
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: 0.76rem;
    font-weight: 600;
  }

  /* ── extra buttons on an amenity card: registration, a mailto ── */
  .pf-amen-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .pf-amen-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgba(61, 47, 122, 0.35);
    background: #fff;
    color: var(--pf-purple);
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;
    transition:
      background 0.15s,
      color 0.15s,
      border-color 0.15s;
  }
  .pf-amen-link:hover,
  .pf-amen-link:focus-visible {
    background: var(--pf-purple);
    border-color: var(--pf-purple);
    color: #fff;
  }
  .pf-amen-link i {
    font-size: 0.8em;
  }

  /* ── Merch ── */
  .pf-merch-header {
    text-align: center;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }
  .pf-merch-intro {
    max-width: 640px;
    margin: 0 auto;
    font-size: clamp(0.95rem, 1.8vw, 1.05rem);
    line-height: 1.7;
  }
  .pf-merch-presale {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    background: #fff;
    border: 1px solid rgba(61, 47, 122, 0.16);
    border-left: 5px solid var(--pf-teal);
    border-radius: 12px;
    padding: clamp(1rem, 2vw, 1.4rem) clamp(1.1rem, 2.5vw, 1.6rem);
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }
  .pf-merch-presale--closed {
    border-left-color: var(--pf-purple-light);
  }
  .pf-merch-presale-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex: 1 1 280px;
  }
  .pf-merch-presale-text strong {
    color: var(--pf-purple-dark);
    font-size: 1.05rem;
  }
  .pf-merch-presale-text span {
    color: #4a3d6b;
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .pf-merch-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }
  @media (min-width: 700px) {
    .pf-merch-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .pf-merch-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  .pf-merch-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: #fff;
    border: 1px solid rgba(61, 47, 122, 0.12);
    border-radius: 14px;
    padding: 1rem 0.9rem 1.1rem;
  }
  .pf-merch-media {
    width: 100%;
    aspect-ratio: 1;
    /* it is a column flex item, whose automatic minimum height is its
       content's — without this the tall hoodie stretches the box past its
       own square and drags its name below the others */
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.75rem;
  }
  /* Fill the square and letterbox inside it. A portrait product (the
     hoodie) would otherwise overflow the box, because a percentage
     max-height has nothing definite to resolve against here, and push its
     own name below the names on every other card. */
  .pf-merch-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .pf-merch-name {
    font-size: 1rem !important;
    color: var(--pf-purple-dark) !important;
    margin: 0 0 0.2rem !important;
  }
  .pf-merch-note {
    margin: 0.2rem 0 0 !important;
    font-size: 0.78rem !important;
    color: rgba(58, 46, 90, 0.7) !important;
  }
  .pf-merch-item-link,
  .pf-merch-item-tent {
    margin-top: auto;
    padding-top: 0.75rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .pf-merch-item-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: var(--pf-teal);
    text-decoration: none;
  }
  .pf-merch-item-link:hover,
  .pf-merch-item-link:focus-visible {
    color: var(--pf-purple);
  }
  .pf-merch-item-tent {
    color: rgba(58, 46, 90, 0.55);
  }
  /* the small goods: same artwork on all of them, so names rather than a
     row of near-identical pictures */
  .pf-merch-extras {
    margin-top: clamp(1.25rem, 3vw, 2rem);
    background: #fff;
    border: 1px solid rgba(61, 47, 122, 0.12);
    border-radius: 12px;
    padding: clamp(1rem, 2.5vw, 1.4rem);
    text-align: center;
  }
  .pf-merch-extras-label {
    font-size: 0.72rem !important;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--pf-purple) !important;
    margin-bottom: 0.8rem !important;
  }
  .pf-merch-extras-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }
  .pf-merch-extras-list li {
    font-size: 0.85rem;
    font-weight: 600;
    color: #3a2e5a;
    background: var(--pf-light-alt);
    border: 1px solid rgba(61, 47, 122, 0.12);
    border-radius: 999px;
    padding: 0.3em 0.9em;
  }

  /* ── Sponsor and supporter disclosure ── */
  .pf-disclosure .pf-disclosure-title {
    font-size: clamp(1.15rem, 2.2vw, 1.5rem) !important;
    margin-bottom: 1rem;
  }
  .pf-disclosure p {
    font-size: 0.85rem !important;
    line-height: 1.7;
    max-width: 68ch;
    color: rgba(255, 255, 255, 0.62) !important;
  }
  .pf-disclosure a {
    color: var(--pf-teal-light);
  }

  /* ── Music Lineup ── */
  .pf-lineup-header,
  .pf-coming-soon {
    text-align: center;
  }
  .pf-lineup-intro {
    max-width: 720px;
    margin: 0.75rem auto 0;
    font-size: clamp(0.92rem, 1.7vw, 1.02rem);
    line-height: 1.7;
  }
  .pf-lineup-intro a {
    color: var(--pf-teal);
    text-decoration: none;
  }
  .pf-lineup-intro a:hover {
    text-decoration: underline;
  }
  .pf-coming-soon {
    padding: clamp(1rem, 3vw, 3rem) 0;
  }
  .pf-coming-soon-headline {
    font-family: var(--font-header);
    font-size: clamp(2rem, 5vw, 3.8rem);
    color: var(--pf-teal-light);
    margin: 0.25rem 0 1rem;
    letter-spacing: 0.02em;
  }
  .pf-coming-soon-line {
    width: 60px;
    height: 3px;
    background: var(--pf-teal);
    margin: 0 auto 1.25rem;
    border-radius: 2px;
  }
  .pf-coming-soon p {
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    opacity: 0.78;
    max-width: 480px;
    margin: 0 auto;
  }
  .pf-coming-soon p a {
    color: var(--pf-teal);
    text-decoration: none;
  }
  .pf-coming-soon p a:hover {
    text-decoration: underline;
  }
  .pf-lineup-list {
    --pf-act-pad: clamp(1.25rem, 2.6vw, 2.25rem);
    /* how far the photo hangs above the panel */
    --pf-act-lift: clamp(2rem, 4vw, 3.5rem);
    /* how tall a photo stands, whatever shape it is — width follows from
       its own aspect ratio, so nothing gets cropped to fit a common box */
    --pf-act-h: clamp(14rem, 24vw, 20rem);
    max-width: 1120px;
    margin: clamp(3rem, 6vw, 5rem) auto 0;
    display: grid;
    /* stays comfortably clear of the photo lifting out of the next panel */
    gap: clamp(3.5rem, 7vw, 6rem);
  }

  /* One act = a raised panel with the photo breaking out of its top edge,
     flipping side to side down the page. */
  .pf-act {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.75rem);
    padding: var(--pf-act-pad);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.09);
  }
  /* A hairline of color along the top, alternating with the photo side */
  .pf-act::before {
    content: "";
    position: absolute;
    inset: -1px; /* sit over the panel's own border, not inside it */
    border-radius: 17px; /* concentric with the panel's 16px */
    background: linear-gradient(
        90deg,
        var(--pf-teal) 0%,
        var(--pf-purple-light) 100%
      )
      top / 100% 3px no-repeat;
    opacity: 0.75;
    pointer-events: none;
  }
  .pf-act--flip::before {
    background-image: linear-gradient(
      90deg,
      var(--pf-purple-light) 0%,
      var(--pf-teal) 100%
    );
  }
  .pf-act--flip {
    grid-template-columns: minmax(0, 1fr) auto;
  }
  .pf-act--flip .pf-act-media {
    order: 2;
  }

  .pf-act-media {
    position: relative;
    align-self: start;
    margin-top: calc(-1 * (var(--pf-act-pad) + var(--pf-act-lift)));
    width: clamp(10rem, calc(var(--pf-act-ar, 1.333) * var(--pf-act-h)), 30rem);
    aspect-ratio: var(--pf-act-ar, 4 / 3);
    border-radius: 12px;
    overflow: hidden;
    background: linear-gradient(
      135deg,
      var(--pf-purple-dark) 0%,
      var(--pf-purple) 55%,
      var(--pf-teal) 100%
    );
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pf-act-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .pf-act-monogram {
    font-family: var(--font-header);
    font-size: clamp(3rem, 8vw, 5.5rem);
    line-height: 1;
    color: rgba(255, 255, 255, 0.85);
  }

  .pf-act-body {
    min-width: 0;
    max-width: 40rem;
  }
  .pf-act-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.6rem;
  }
  .pf-act-stage {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #fff;
    background: var(--pf-teal);
    padding: 0.15em 0.6em;
    border-radius: 4px;
  }
  .pf-act-area {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 0.15em 0.6em;
    border-radius: 4px;
  }
  .pf-act-area i {
    color: var(--pf-teal);
  }
  a.pf-act-area:hover,
  a.pf-act-area:focus-visible {
    background: rgba(255, 255, 255, 0.12);
    border-color: #fff;
    color: #fff;
  }
  .pf-act-time {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.6);
  }
  .pf-act-name {
    font-family: var(--font-header);
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    line-height: 1.1;
    letter-spacing: 0.01em;
    color: #fff;
    margin: 0 0 0.6rem;
  }
  .pf-act-blurb {
    font-size: clamp(0.92rem, 1.6vw, 1rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.72);
    margin: 0;
  }
  .pf-act-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.1rem;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    border: 1px solid rgba(42, 196, 179, 0.5);
    color: var(--pf-teal-light);
    background: rgba(42, 196, 179, 0.08);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }
  .pf-act-link:hover,
  .pf-act-link:focus-visible {
    background: var(--pf-teal);
    border-color: var(--pf-teal);
    color: var(--pf-dark);
  }

  /* Phones: photo goes full-bleed across the top of the panel, words below */
  @media (max-width: 820px) {
    .pf-act,
    .pf-act--flip {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .pf-act::before {
      display: none;
    }
    .pf-act--flip .pf-act-media {
      order: 0;
    }
    .pf-act-media {
      width: auto;
      max-width: none;
      margin: calc(-1 * var(--pf-act-pad)) calc(-1 * var(--pf-act-pad))
        var(--pf-act-pad);
      border-radius: 15px 15px 0 0;
      box-shadow: none;
    }
    .pf-act-body {
      max-width: none;
    }
  }

  .pf-emcee-strip {
    max-width: 720px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    margin-top: clamp(1.25rem, 3vw, 2rem);
    padding: 1rem 1.25rem;
    border-radius: 999px;
    background: rgba(42, 196, 179, 0.12);
    border: 1px solid rgba(42, 196, 179, 0.35);
    text-align: center;
  }
  .pf-emcee-strip i {
    color: var(--pf-teal);
    font-size: 1.1rem;
    flex-shrink: 0;
  }
  .pf-emcee-strip span {
    font-size: clamp(0.92rem, 1.8vw, 1.05rem);
    font-weight: 700;
    color: #fff;
  }
  .pf-emcee-link {
    color: var(--pf-teal-light);
    text-decoration: none;
    border-bottom: 1px solid rgba(77, 217, 203, 0.45);
    white-space: nowrap;
  }
  .pf-emcee-link:hover,
  .pf-emcee-link:focus-visible {
    border-bottom-color: var(--pf-teal-light);
  }

  /* ── 75th anniversary ── */
  .pf-75th-media {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.5rem, 4vw, 3.5rem);
    box-sizing: border-box;
    background: var(--pf-dark);
  }
  .pf-75th-figure {
    margin: 0;
    width: 100%;
  }
  .pf-75th-figure figcaption {
    margin-top: 0.75rem;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.5;
  }
  .pf-75th-text {
    position: relative;
  }
  .pf-75th-corner-logo {
    position: absolute;
    top: clamp(1.25rem, 3vw, 2.5rem);
    right: clamp(1.25rem, 3vw, 2.5rem);
    width: 110px;
    max-width: 160px;
    height: auto;
    opacity: 0.75;
  }
  .pf-75th-text h2 {
    font-size: clamp(1.9rem, 4vw, 3rem) !important;
  }
  .pf-75th-link {
    align-self: flex-start;
    color: var(--pf-teal-light);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid rgba(77, 217, 203, 0.4);
  }
  .pf-75th-link:hover {
    border-bottom-color: var(--pf-teal-light);
  }
  @media (max-width: 520px) {
    .pf-75th-corner-logo {
      position: static;
      display: block;
      margin-bottom: 1rem;
      opacity: 0.85;
    }
  }

  /* ── Get Involved ── */
  .pf-involved-header {
    text-align: center;
    margin-bottom: clamp(1.5rem, 3vw, 3rem);
  }
  .pf-involved-grid {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 860px) {
    .pf-involved-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .pf-involved-card {
    text-align: center;
    padding: clamp(1.25rem, 2.5vw, 2rem) 1rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    height: 100%;
    box-sizing: border-box;
  }
  .pf-involved-card .pf-btn {
    width: 100%;
    text-align: center;
    white-space: normal;
    word-break: break-word;
    box-sizing: border-box;
  }
  .pf-involved-icon {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    color: var(--pf-teal-light);
    margin-bottom: 0.25rem;
  }
  .pf-involved-card h3 {
    color: #fff;
    font-size: 1rem;
    margin: 0;
  }
  .pf-involved-card p {
    font-size: 0.85rem;
    opacity: 0.72;
    margin: 0;
    line-height: 1.4;
    flex: 1;
  }
  .pf-involved-more {
    text-align: center;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  /* ── Sponsors ── */
  .pf-sponsors-inner {
    text-align: center;
  }
  .pf-sponsor-tiers {
    margin-top: 2rem;
  }
  .pf-sponsor-tier {
    margin-bottom: 1.5rem;
  }
  .pf-sponsor-tier-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--pf-teal);
    font-weight: 700;
    margin-bottom: 0.6rem;
  }
  .pf-sponsor-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: center;
  }
  /* Type size follows the tier itself, not its position in the list, so a
     year with no Diamond sponsor does not promote Platinum to the top size. */
  .pf-sponsor-name {
    font-size: 0.95rem;
    color: #3a2e5a;
  }
  .pf-sponsor-tier[data-tier="diamond"] .pf-sponsor-name {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--pf-purple-dark);
  }
  .pf-sponsor-tier[data-tier="platinum"] .pf-sponsor-name {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--pf-purple);
  }
  .pf-sponsor-tier[data-tier="gold"] .pf-sponsor-name {
    font-size: 1.05rem;
    font-weight: 600;
  }
  /* Special Thanks sits apart from the paid tiers: a rule above it, and
     Gold-sized type */
  .pf-sponsor-tier[data-tier="special"] {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(61, 47, 122, 0.14);
  }
  .pf-sponsor-tier[data-tier="special"] .pf-sponsor-name {
    font-size: 1.05rem;
    font-weight: 600;
  }
  .pf-sponsor-name {
    text-decoration: none;
  }
  a.pf-sponsor-name:hover {
    color: var(--pf-teal);
    text-decoration: underline;
  }
  /* ── Special Thanks ── */
  .pf-thanks-inner {
    text-align: center;
  }
  .pf-thanks-intro {
    max-width: 62ch;
    margin: 0 auto;
    font-size: 1rem;
    line-height: 1.6;
  }
  .pf-thanks-groups {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    display: grid;
    gap: clamp(1.75rem, 3vw, 2.5rem);
  }
  .pf-thanks-group-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--pf-teal);
    font-weight: 700;
    margin-bottom: 0.9rem;
  }
  .pf-thanks-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1.1rem 1.5rem;
  }
  .pf-thanks-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .pf-thanks-name {
    font-size: 1.02rem;
    font-weight: 600;
    color: #fff;
    text-decoration: none;
  }
  a.pf-thanks-name:hover {
    color: var(--pf-teal-light);
    text-decoration: underline;
  }
  .pf-thanks-what {
    font-size: 0.88rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.72);
  }
  /* The breweries carry no line of their own — the heading already says what
     they are doing — so they read better as a row of names than as a grid of
     mostly-empty cells. */
  .pf-thanks-group[data-group="beer"] .pf-thanks-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
  }

  .pf-sponsor-cta {
    margin-top: 1.25rem;
    font-size: 0.95rem;
  }
  .pf-sponsor-cta a {
    color: var(--pf-purple);
    font-weight: 700;
  }
  .pf-sponsor-empty {
    margin-top: 1.5rem;
    font-size: 1rem;
    color: #3a2e5a;
  }
  .pf-sponsor-empty a {
    color: var(--pf-purple);
  }

  /* ── FAQ ── */
  .pf-faq-layout {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    grid-template-columns: 1fr;
    align-items: start;
  }
  @media (min-width: 768px) {
    .pf-faq-layout {
      grid-template-columns: 35% 1fr;
    }
  }
  .pf-faq-intro h2 {
    margin-bottom: 0.75rem;
  }
  .pf-faq-intro p {
    font-size: clamp(0.9rem, 1.8vw, 1rem);
    line-height: 1.65;
    margin: 0;
  }
  .pf-faq-intro p a {
    color: var(--pf-teal);
    text-decoration: none;
  }
  .pf-faq-intro p a:hover {
    text-decoration: underline;
  }
  .pf-press-link {
    margin-top: 1rem !important;
    font-size: 0.9rem !important;
    color: rgba(255, 255, 255, 0.6) !important;
  }
  .pf-faq {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .pf-faq-item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
    transition: border-color 0.2s;
  }
  .pf-faq-item.is-open {
    border-left: 3px solid var(--pf-teal);
    margin-left: -3px;
  }
  .pf-faq-button {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: clamp(0.9rem, 1.5vw, 1.1rem) 0;
    text-align: left;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: clamp(0.9rem, 1.6vw, 1rem);
    font-weight: 600;
    color: #fff;
    transition: color 0.15s;
  }
  .pf-faq-button:hover {
    color: var(--pf-teal-light);
  }
  .pf-faq-chevron {
    flex-shrink: 0;
    transition:
      transform 0.25s,
      color 0.2s;
    color: rgba(255, 255, 255, 0.35);
  }
  .pf-faq-item.is-open .pf-faq-chevron {
    transform: rotate(180deg);
    color: var(--pf-teal);
  }
  .pf-faq-item.is-open .pf-faq-button {
    color: var(--pf-teal-light);
  }
  .pf-faq-content {
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.3s ease-in-out;
  }
  .pf-faq-content p {
    padding-bottom: 1.1rem;
    font-size: clamp(0.88rem, 1.5vw, 0.95rem);
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.7;
    margin: 0;
  }

  .pf-gallery-more {
    text-align: center;
    padding: clamp(1.25rem, 3vw, 2rem) clamp(24px, 6vw, 80px) 0;
  }

  /* ── Photo credit ── */
  .pf-photo-credit {
    text-align: center;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.45) !important;
    padding: 1rem clamp(24px, 6vw, 80px) 0;
    margin: 0;
  }
  .pf-photo-credit a {
    color: rgba(255, 255, 255, 0.7);
  }
  .pf-photo-credit a:hover {
    color: var(--pf-teal-light);
  }

  /* ── History Teaser ── */
  .pf-history-section {
    background-size: cover;
    background-position: center;
    position: relative;
  }
  .pf-history-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(11, 9, 23, 0.88);
  }
  .pf-history-inner {
    position: relative;
    text-align: center;
  }
  .pf-history-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    flex-wrap: wrap;
    margin: 1rem 0 1.5rem;
  }
  .pf-history-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .pf-history-stat-num {
    font-family: var(--font-header);
    font-size: clamp(2rem, 6vw, 3.5rem);
    color: var(--pf-teal);
    line-height: 1;
  }
  .pf-history-stat-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.5);
    margin-top: 0.2rem;
  }
  .pf-history-stat-dot {
    font-size: 1.5rem;
    color: rgba(255, 255, 255, 0.2);
    align-self: center;
  }
  .pf-history-inner p {
    max-width: 520px;
    margin: 0 auto 1.5rem;
    font-size: clamp(0.95rem, 2vw, 1.05rem);
  }

  /* ── Print — the page doubles as the day-of program ── */
  @media print {
    .pf-hero {
      min-height: auto;
      background-image: none !important;
    }
    .pf-hero::before {
      display: none;
    }
    .pf-hero-overlay {
      position: static;
      background: none;
      padding: 0;
    }
    .pf-75th-strip {
      display: none;
    }
    .pf-hero-content {
      color: #000;
    }
    .pf-hero-title,
    .pf-hero-year {
      color: #000;
    }
    .pf-section--dark,
    .pf-section--purple {
      background: #fff;
      color: #000;
    }
    .pf-section--dark h2,
    .pf-section--purple h2,
    .pf-section--dark h3,
    .pf-section--dark p,
    .pf-section--purple p {
      color: #000;
    }
    .pf-photo-band,
    .pf-gallery-masonry,
    .pf-75th-media {
      display: none;
    }
    .pf-hero-ctas,
    .pf-hero-event,
    .pf-merch-presale,
    .pf-gallery-more,
    .pf-btn--disabled {
      display: none;
    }
  }

  /* ══════════════════════════════════════════════════════════════
     DAY-OF SECTIONS
     Schedule, maps, food and vendors, sponsor ads, the people thanks and
     the winners. Phone layout first; the wider breakpoints are the
     special case.
     ══════════════════════════════════════════════════════════════ */

  /* ── Schedule ─────────────────────────────────────────────── */
  .pf-sched-header {
    text-align: center;
    margin-bottom: clamp(1.5rem, 3vw, 2rem);
  }
  .pf-sched-intro {
    max-width: 52ch;
    margin: 0.5rem auto 0;
    font-size: clamp(0.92rem, 1.7vw, 1.02rem);
    line-height: 1.65;
  }

  /* "On right now": hidden until the browser decides it is event day */
  .pf-now {
    background: rgba(42, 196, 179, 0.1);
    border: 1px solid rgba(42, 196, 179, 0.45);
    border-radius: 12px;
    padding: 1rem 1.1rem 1.1rem;
    margin-bottom: 1.75rem;
  }
  .pf-now-head {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
  }
  .pf-now-head h3 {
    margin: 0;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
  }
  .pf-now-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--pf-teal);
    flex: none;
    animation: pf-pulse 2s ease-in-out infinite;
  }
  @keyframes pf-pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.45;
      transform: scale(0.8);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pf-now-dot {
      animation: none;
    }
  }
  .pf-now-clock {
    margin-left: auto;
    font-variant-numeric: tabular-nums;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
  }
  .pf-now-grid {
    display: grid;
    gap: 0.6rem;
  }
  /* The rows inside are built by the clock script, so they do not carry
     this page's scoping attribute and have to be styled as globals. */
  .pf-now-grid :global(.pf-now-row) {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.15rem 0.75rem;
    align-items: baseline;
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    text-decoration: none;
    color: inherit;
  }
  .pf-now-grid :global(a.pf-now-row:hover),
  .pf-now-grid :global(a.pf-now-row:focus-visible) {
    background: rgba(255, 255, 255, 0.12);
  }
  .pf-now-grid :global(.pf-now-stage) {
    grid-column: 1 / -1;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--pf-teal-light);
  }
  .pf-now-grid :global(.pf-now-act) {
    font-weight: 700;
    color: #fff;
  }
  .pf-now-grid :global(.pf-now-when) {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .pf-now-grid :global(.pf-now-row[data-pf-state="next"] .pf-now-act),
  .pf-now-grid :global(.pf-now-row[data-pf-state="done"] .pf-now-act) {
    font-weight: 600;
    color: rgba(255, 255, 255, 0.8);
  }
  .pf-now-next,
  .pf-now-grid :global(.pf-now-empty) {
    margin: 0.85rem 0 0;
    font-size: 0.92rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85) !important;
  }
  .pf-now-grid :global(.pf-now-empty) {
    margin-top: 0;
  }
  .pf-now-next :global(strong) {
    color: #fff;
  }

  /* Stage columns */
  .pf-sched-stages {
    display: grid;
    gap: 1rem;
  }
  .pf-sched-stage {
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 12px;
    overflow: hidden;
  }
  .pf-sched-stage-head {
    padding: 0.85rem 1rem;
    background: rgba(61, 47, 122, 0.55);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .pf-sched-stage-head h3 {
    margin: 0;
    font-size: 1.1rem;
  }
  .pf-sched-stage-area {
    display: block;
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--pf-teal-light);
    margin-top: 0.15rem;
  }
  .pf-sched-sets {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pf-sched-sets li + li {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .pf-sched-set {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.1rem 0.75rem;
    padding: 0.75rem 1rem;
    text-decoration: none;
    color: inherit;
    min-height: 44px;
    align-items: center;
  }
  .pf-sched-set:hover,
  .pf-sched-set:focus-visible {
    background: rgba(42, 196, 179, 0.12);
  }
  .pf-sched-time {
    grid-column: 1;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    color: var(--pf-teal-light);
  }
  .pf-sched-name {
    grid-column: 1;
    grid-row: 2;
    font-weight: 700;
    font-size: 1rem;
    color: #fff;
  }
  .pf-sched-chev {
    grid-column: 2;
    grid-row: 1 / span 2;
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.8rem;
  }
  /* the set that is on right now, flagged by the clock script */
  .pf-sched-set[data-pf-live] {
    background: rgba(42, 196, 179, 0.16);
    box-shadow: inset 3px 0 0 var(--pf-teal);
  }
  .pf-sched-set[data-pf-live] .pf-sched-time::after {
    content: " · now";
    color: #fff;
    font-weight: 700;
  }
  /* A canceled act stays on the schedule, struck through and tagged. It
     was on every poster, so people will look for it. */
  .pf-cancel-tag {
    display: inline-block;
    margin-left: 0.45rem;
    padding: 0.1em 0.55em;
    border-radius: 999px;
    background: #fff;
    color: var(--pf-purple-dark);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    vertical-align: middle;
  }
  .pf-sched-set[data-pf-canceled] .pf-sched-time {
    text-decoration: line-through;
  }
  .pf-sched-set[data-pf-canceled] .pf-sched-time,
  .pf-sched-set[data-pf-canceled] .pf-sched-name s,
  .pf-tl[data-pf-canceled] .pf-keytime-title s {
    color: rgba(255, 255, 255, 0.6);
  }
  .pf-act--canceled .pf-act-media img {
    filter: grayscale(1);
    opacity: 0.7;
  }
  .pf-act--canceled .pf-act-time {
    text-decoration: line-through;
  }
  .pf-act-cancel {
    margin: 0 0 0.9rem;
    font-weight: 700;
    color: #fff;
  }

  /* Open mic */
  .pf-openmic {
    margin-top: 1.5rem;
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 12px;
    padding: 1.1rem;
  }
  .pf-openmic-head h3 {
    margin: 0 0 0.3rem;
    font-size: 1.1rem;
  }
  .pf-openmic-head h3 i {
    color: var(--pf-teal);
  }
  .pf-openmic-head p {
    margin: 0 0 0.9rem;
    font-size: 0.92rem;
  }
  .pf-openmic-head a {
    color: var(--pf-teal-light);
  }
  .pf-openmic-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.1rem;
  }
  .pf-openmic-list li {
    display: grid;
    grid-template-columns: 5.4rem 1fr;
    gap: 0.6rem;
    padding: 0.42rem 0.3rem;
    align-items: baseline;
  }
  .pf-openmic-list li + li {
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }
  .pf-openmic-time {
    font-variant-numeric: tabular-nums;
    font-size: 0.85rem;
    color: var(--pf-teal-light);
  }
  .pf-openmic-name {
    font-weight: 600;
    color: #fff;
  }

  /* Key times */
  .pf-keytimes {
    margin-top: 1.75rem;
  }
  .pf-keytimes-title {
    font-size: 1.15rem;
    margin: 0 0 1rem;
  }
  .pf-keytimes-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pf-keytime {
    display: grid;
    grid-template-columns: 4.6rem 2rem 1fr;
    gap: 0 0.5rem;
    padding-bottom: 1.05rem;
    position: relative;
  }
  /* the connecting line down the timeline */
  .pf-keytime:not(:last-child) .pf-keytime-dot::after {
    content: "";
    position: absolute;
    top: 2rem;
    left: 50%;
    width: 1px;
    height: calc(100% + 1.05rem - 2rem);
    background: rgba(255, 255, 255, 0.16);
    transform: translateX(-50%);
  }
  .pf-keytime-when {
    font-variant-numeric: tabular-nums;
    font-size: 0.85rem;
    color: var(--pf-teal-light);
    padding-top: 0.42rem;
    text-align: right;
  }
  .pf-keytime-dot {
    position: relative;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: rgba(61, 47, 122, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.18);
    display: grid;
    place-items: center;
    font-size: 0.8rem;
    color: var(--pf-teal-light);
  }
  .pf-keytime-body {
    padding-top: 0.3rem;
    min-width: 0;
  }
  .pf-keytime-title {
    display: block;
    font-size: 1rem;
    line-height: 1.35;
    color: #fff;
  }
  .pf-keytime-area {
    display: inline-block;
    margin-top: 0.25rem;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: rgba(42, 196, 179, 0.18);
    color: var(--pf-teal-light);
  }
  a.pf-keytime-area:hover,
  a.pf-keytime-area:focus-visible {
    background: var(--pf-teal);
    color: #06201d;
  }
  .pf-keytime-body p {
    margin: 0.35rem 0 0;
    font-size: 0.91rem;
    line-height: 1.5;
  }
  /* already finished, dimmed by the clock script */
  .pf-keytime[data-pf-past] {
    opacity: 0.45;
  }
  .pf-keytime[data-pf-soon] .pf-keytime-dot {
    background: var(--pf-teal);
    color: #06201d;
    border-color: var(--pf-teal);
  }
  /* ── Two readings of the same schedule ──
     By stage for planning, by time for standing in the field. The script
     picks one by phase and stamps data-pf-sched-view; until it does, both
     lists show and the toggle stays hidden, so nothing is stranded. */
  .pf-sched-toggle {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }
  .pf-sched-toggle button {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    min-height: 40px;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: transparent;
    color: #fff;
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
  }
  .pf-sched-toggle button[aria-pressed="true"] {
    background: var(--pf-teal);
    border-color: var(--pf-teal);
    color: #06201d;
    font-weight: 700;
  }
  .pf-sched-views:not([data-pf-sched-view]) .pf-sched-toggle {
    display: none;
  }
  .pf-sched-views[data-pf-sched-view] .pf-timeline-title {
    display: none;
  }
  .pf-sched-views[data-pf-sched-view="time"] [data-pf-view="stage"],
  .pf-sched-views[data-pf-sched-view="stage"] [data-pf-view="time"] {
    display: none;
  }
  .pf-sched-views:not([data-pf-sched-view]) .pf-timeline {
    margin-top: 2.25rem;
  }
  /* rows that start together share one time label */
  .pf-tl[data-pf-tl-same] .pf-keytime-when {
    visibility: hidden;
  }
  .pf-tl-link {
    text-decoration: none;
  }
  .pf-tl-link:hover,
  .pf-tl-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .pf-tl-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.6rem;
  }
  .pf-tl-where {
    display: inline-block;
    margin-top: 0.25rem;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.72);
  }
  .pf-tl[data-pf-live] .pf-keytime-dot {
    background: var(--pf-teal);
    color: #06201d;
    border-color: var(--pf-teal);
  }
  .pf-tl[data-pf-live] .pf-keytime-when::after {
    content: " now";
    display: block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #fff;
  }
  .pf-sched-foot {
    margin: 1.75rem 0 0;
    text-align: center;
    font-size: 0.92rem;
  }
  .pf-sched-foot i {
    color: var(--pf-teal);
  }

  @media (min-width: 760px) {
    .pf-sched-stages {
      grid-template-columns: repeat(3, 1fr);
      align-items: start;
    }
    .pf-openmic-list {
      grid-template-columns: 1fr 1fr;
      column-gap: 2rem;
    }
    .pf-openmic-list li + li {
      border-top: none;
    }
    .pf-openmic-list li {
      border-top: 1px solid rgba(255, 255, 255, 0.07);
    }
    .pf-keytime {
      grid-template-columns: 5.5rem 2.25rem 1fr;
    }
    .pf-now-grid {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
  }

  /* ── Tabbed map viewer ────────────────────────────────────── */
  .pf-plan-promise {
    margin: 0.5rem auto 0;
    max-width: 48ch;
    font-size: 0.95rem;
  }
  .pf-plan-promise i {
    color: var(--pf-teal);
  }
  .pf-mapview {
    margin-bottom: 1.5rem;
    scroll-margin-top: calc(var(--pf-nav-h) + 12px);
  }
  .pf-mapview-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.9rem;
  }
  .pf-mapview-tab {
    flex: none;
    min-height: 40px;
    /* a chip's address lands here without script; keep it under the nav */
    scroll-margin-top: calc(var(--pf-nav-h) + 12px);
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: transparent;
    color: #fff;
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
    white-space: nowrap;
  }
  .pf-mapview-tab[aria-selected="true"] {
    background: var(--pf-teal);
    border-color: var(--pf-teal);
    color: #06201d;
    font-weight: 700;
  }
  .pf-mapview-title {
    font-size: 1.05rem;
    margin: 0 0 0.6rem;
  }
  .pf-mapview-frame {
    display: block;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    overflow: hidden;
    width: 100%;
  }
  .pf-mapview-frame img {
    display: block;
    width: 100%;
    height: auto;
  }
  .pf-mapview-note {
    margin: 0.65rem 0 0;
    font-size: 0.9rem;
  }
  .pf-mapview-full {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.4rem;
    min-height: 44px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--pf-teal-light);
    text-decoration: none;
  }
  .pf-mapview-full:hover,
  .pf-mapview-full:focus-visible {
    text-decoration: underline;
  }
  .pf-mapview-tip {
    margin: 0.75rem 0 0;
    font-size: 0.88rem;
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
  }
  .pf-mapview-tip i {
    color: var(--pf-teal);
    margin-top: 0.2rem;
  }

  /* ── Food, vendors, responders ────────────────────────────── */
  .pf-here-header {
    text-align: center;
    margin-bottom: 1.75rem;
  }
  .pf-here-block + .pf-here-block {
    margin-top: 2.25rem;
    padding-top: 2.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
