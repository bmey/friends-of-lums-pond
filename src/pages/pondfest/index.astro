      <section class="pf-section pf-section--dark" data-phase="event">
        <div class="pf-section-inner pf-section-inner--mid">
          <h2>Raffles &amp; Auction</h2>
          <div class="pf-dayof-link-cards">
            {RAFFLE_LINK && (
              <a
                href={RAFFLE_LINK}
                target="_blank"
                rel="noopener"
                class="pf-dayof-link-card"
              >
                <i class="fa-solid fa-ticket pf-dayof-link-icon" />
                <div>
                  <strong>Raffle Info &amp; Results</strong>
                  <p>View raffle items and winner announcements</p>
                </div>
                <i class="fa-solid fa-arrow-right pf-dayof-link-arrow" />
              </a>
            )}
            {AUCTION_LINK && (
              <a
                href={AUCTION_LINK}
                target="_blank"
                rel="noopener"
                class="pf-dayof-link-card"
              >
                <i class="fa-solid fa-gavel pf-dayof-link-icon" />
                <div>
                  <strong>Silent Auction</strong>
                  <p>View auction items and place or check bids</p>
                </div>
                <i class="fa-solid fa-arrow-right pf-dayof-link-arrow" />
              </a>
            )}
          </div>
        </div>
      </section>
    )
  }

  <!-- ══ THANK YOU — leads the page in the weeks after the festival ═══ -->
  <PondFestNext
    id="pf-thankyou"
    phases={["afterglow"]}
    variant="afterglow"
    winnersLive={hasWinners}
  />

  <!-- ══ WINNERS — appears only once winners.ts says WINNERS_LIVE ══ -->
  {
    hasWinners && (
      <section class="pf-section pf-section--purple" id="pf-winners">
        <div class="pf-section-inner pf-section-inner--mid">
          <div class="pf-winners-header">
            <h2>Winners</h2>
            {WINNERS_NOTE ? (
              <p class="pf-winners-note">{WINNERS_NOTE}</p>
            ) : (
              WINNERS_CLAIM_NOTE && (
                <p class="pf-winners-note">{WINNERS_CLAIM_NOTE}</p>
              )
            )}
          </div>

          {hasFiftyFifty && (
            <div class="pf-fifty">
              <span class="pf-fifty-label">50/50 winning ticket</span>
              <span class="pf-fifty-ticket">{FIFTY_FIFTY_TICKET}</span>
              {FIFTY_FIFTY_AMOUNT && (
                <span class="pf-fifty-amount">
                  takes home {FIFTY_FIFTY_AMOUNT}
                </span>
              )}
            </div>
          )}

          <div class="pf-winners-cols">
            {raffleWinners.length > 0 && (
              <div class="pf-winners-block">
                <h3>
                  <i class="fa-solid fa-ticket" aria-hidden="true" /> Raffle
                </h3>
                <ol class="pf-winners-list">
                  {raffleWinners.map((w) => (
                    <li class="pf-winners-row">
                      {w.prize && (
                        <span class="pf-winners-prize">{w.prize}</span>
