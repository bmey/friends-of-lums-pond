            ))
          }
        </div>
        {
          FACEBOOK_EVENT_URL && (
            <a
              class="pf-hero-event"
              href={FACEBOOK_EVENT_URL}
              target="_blank"
              rel="noopener"
              data-phase="prep afterglow"
            >
              <i class="fa-brands fa-facebook" aria-hidden="true" />
              RSVP on the Facebook event
            </a>
          )
        }
      </div>
    </div>
  </section>

  <!-- ══ QUICK LINKS — first thing past the fold, and the sentinel the
       sticky bar watches to know when to pin itself ══════════════════ -->
  <PondFestQuickLinks sections={navSections} />

  <!-- ══ 75th STRIP — sits under the hero so the hero stays short ═══ -->
  <a class="pf-75th-strip" href="#pf-75th">
    <img
      src={SEVENTY_FIFTH_LOGO_WHITE}
