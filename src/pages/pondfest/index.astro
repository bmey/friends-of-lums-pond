              class="pf-mapview-tabs"
              role="tablist"
              aria-label="Pond Fest maps"
            >
              {eventMaps.map((m, i) => (
                <button
                  type="button"
                  role="tab"
                  id={`pf-maptab-${m.id}`}
                  class="pf-mapview-tab"
                  aria-selected={i === 0 ? "true" : "false"}
                  aria-controls={`pf-mappanel-${m.id}`}
                  tabindex={i === 0 ? 0 : -1}
                  data-pf-maptab={m.id}
                >
                  {m.label}
                </button>
              ))}
            </div>
            {eventMaps.map((m, i) => (
              <div
                class="pf-mapview-panel"
                id={`pf-mappanel-${m.id}`}
                role="tabpanel"
                aria-labelledby={`pf-maptab-${m.id}`}
                hidden={i !== 0}
              >
                <h3 class="pf-mapview-title">{m.title}</h3>
                {/* Only the first map ships a src. The rest carry data-src
                    and are fetched the first time their tab is opened, which
                    is what keeps six maps off the critical path. */}
                <div
                  class="pf-mapview-frame"
                  style={
                    m.width && m.height
                      ? `aspect-ratio: ${m.width} / ${m.height};`
                      : undefined
                  }
                >
                  <img
                    src={i === 0 ? m.src : undefined}
                    data-src={i === 0 ? undefined : m.src}
                    alt={m.alt}
                    width={m.width}
                    height={m.height}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                {m.note && <p class="pf-mapview-note">{m.note}</p>}
                <a
                  class="pf-mapview-full"
                  href={m.full}
                  target="_blank"
                  rel="noopener"
                >
                  <i class="fa-solid fa-magnifying-glass-plus" /> Open the
                  full-size map
                </a>
              </div>
            ))}
