<Layout
  title={`Pond Fest ${CURRENT_YEAR} | Friends of Lums Pond`}
  description={`Pond Fest ${CURRENT_YEAR}. ${EVENT_DATE_DISPLAY}, Lums Pond State Park. Free, dog-friendly community festival: live music on three stages, beer garden, food trucks, kids' activities, and more. Standard park entrance fee applies.`}
  ogImage={OG_IMAGE_URL}
  phase={phase}
>
  <!-- Re-decide the phase in the browser, before anything paints, so the
       page flips from "event" to "afterglow" overnight on its own. Keep the
       rules in step with src/data/pondfest/phase.ts. -->
  <script
    is:inline
    slot="head"
    define:vars={{ pfEventDate: EVENT_DATE, pfPhaseOverride: PHASE_OVERRIDE }}
  >
    (function () {
      var root = document.documentElement;
      if (pfPhaseOverride) {
        root.dataset.pfPhase = pfPhaseOverride;
        return;
      }
      var zoned = function (iso) {
        return /(Z|[+-]\d\d:\d\d)$/i.test(iso) ? iso : iso + "-04:00";
      };
      var start = new Date(zoned(pfEventDate)).getTime();
      var dayEnd = new Date(
        zoned(pfEventDate.slice(0, 10) + "T23:59:59"),
      ).getTime();
      var now = Date.now();
      root.dataset.pfPhase =
        now > dayEnd
          ? "afterglow"
          : now >= start - 7 * 24 * 60 * 60 * 1000
          ? "event"
          : "prep";
    })();
  </script>
  <!-- The hero is a CSS background, which the browser only discovers after
       it has parsed the stylesheet. Preloading starts the download alongside
       the HTML instead, one file per screen size. Not on event day, when the
       hero is a band with no photo behind it. -->
  {
    phase !== "event" && (
      <link
        slot="head"
        rel="preload"
        as="image"
        href={HERO_IMAGE_MOBILE_URL || HERO_IMAGE_URL}
        media="(max-width: 768px)"
      />
    )
  }
  {
    phase !== "event" && (
      <link
        slot="head"
        rel="preload"
        as="image"
        href={HERO_IMAGE_URL}
        media="(min-width: 769px)"
      />
    )
  }
  <!-- ══ WINNERS BANNER — the loudest thing on the page once the draws
       are posted, and gone again the moment WINNERS_LIVE is false ═══ -->
  {
    hasWinners && (
      <a class="pf-winners-banner" href="#pf-winners" data-phase="event">
        <i class="fa-solid fa-trophy" aria-hidden="true" />
        <span>
          <strong>Raffle, 50/50 and auction winners are posted.</strong> Tap to
          see if that is you.
        </span>
        <i class="fa-solid fa-arrow-right" aria-hidden="true" />
      </a>
    )
  }

  <!-- ══ ALERT BANNER ════════════════════════════════════════════════ -->
  {
    DAY_OF_ALERT && (
      <div class="pf-alert-banner" role="alert">
        <i class="fa-solid fa-circle-info" />
        {DAY_OF_ALERT}
      </div>
    )
  }

  <!-- ══ HERO ═══════════════════════════════════════════════════════ -->
  <section
    class="pf-hero"
    style={`--pf-hero-img: url('${HERO_IMAGE_URL}'); --pf-hero-img-sm: url('${
      HERO_IMAGE_MOBILE_URL || HERO_IMAGE_URL
    }')`}
    data-presale-deadline={MERCH_PRESALE_DEADLINE || undefined}
  >
    <div class="pf-hero-overlay">
      <div class="pf-hero-content">
        <div class="pf-hero-eyebrow" data-phase="prep afterglow">
          Friends of Lums Pond presents
        </div>
        <h1 class="pf-hero-title">
          Pond Fest <span class="pf-hero-year">{CURRENT_YEAR}</span>
        </h1>
        <p class="pf-hero-meta">
          <span class="pf-nowrap">
            <i class="fa-solid fa-calendar-days"></i>
            {EVENT_DATE_DISPLAY}
          </span>
          <span class="pf-hero-meta-sep">&nbsp;&middot;&nbsp;</span>
          <span class="pf-nowrap">
            <i class="fa-solid fa-clock"></i>
            {EVENT_TIME}
          </span>
          <br />
          <span class="pf-nowrap">
            <i class="fa-solid fa-location-dot"></i>
            {EVENT_LOCATION}
          </span>
        </p>
        <p class="pf-hero-tagline" data-phase="prep afterglow">
          {EVENT_TAGLINE}
        </p>
        <p class="pf-hero-free" data-phase="prep afterglow">
          Free to attend &middot; standard park entrance fee applies
        </p>
        <PondFestCountdown startDate={EVENT_DATE} year={CURRENT_YEAR} />
        <div class="pf-hero-ctas" data-phase="prep afterglow">
          {
            ctaLinks.map((cta) => (
              <a
                href={cta.url}
                class={`pf-btn ${cta.style}`}
