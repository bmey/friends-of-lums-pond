                      </span>
                    )}
                  </div>
                  <div class="pf-act-body">
                    {(performer.stage || performer.time) && (
                      <div class="pf-act-meta">
                        {performer.stage && (
                          <span class="pf-act-stage">
                            {splitStage(performer.stage).name}
                          </span>
                        )}
                        {performer.stage &&
                          splitStage(performer.stage).area &&
                          (hasMapView ? (
                            <a
                              class="pf-act-area pf-area-chip"
                              href={`#pf-maptab-${mapForArea(
                                splitStage(performer.stage).area,
                              )}`}
                              data-pf-map={mapForArea(
                                splitStage(performer.stage).area,
                              )}
                            >
                              <i
                                class="fa-solid fa-location-dot"
                                aria-hidden="true"
                              />{" "}
                              {splitStage(performer.stage).area}
                            </a>
                          ) : (
                            <span class="pf-act-area">
                              {splitStage(performer.stage).area}
                            </span>
                          ))}
                        {performer.time && (
                          <span class="pf-act-time">{performer.time}</span>
                        )}
                        {performer.canceled && (
                          <span class="pf-cancel-tag">Canceled</span>
                        )}
                      </div>
                    )}
                    <h3 class="pf-act-name">{performer.name}</h3>
                    {performer.canceled && (
                      <p class="pf-act-cancel">{performer.canceled}</p>
                    )}
                    {performer.blurb && (
                      <p class="pf-act-blurb">{performer.blurb}</p>
                    )}
                    {performer.url && (
                      <a
                        class="pf-act-link"
