  <section class="pf-section pf-section--dark pf-section--lazy" id="pf-lineup">
    <div class="pf-section-inner">
      {
        hasLineup ? (
          <>
            <div class="pf-lineup-header">
              <h2>{hasSchedule ? "Meet the Bands" : "Music Lineup"}</h2>
              <p class="pf-lineup-intro">
