</style>

<script>
  function setupFAQ() {
    const items = document.querySelectorAll(
      ".pf-faq-item",
    ) as NodeListOf<HTMLElement>;
    items.forEach((item) => {
      const btn = item.querySelector(".pf-faq-button") as HTMLButtonElement;
      const content = item.querySelector(
        ".pf-faq-content",
      ) as HTMLElement | null;
      if (!btn || !content) return;
      btn.addEventListener("click", () => {
        const isOpen = item.classList.contains("is-open");
        if (isOpen) {
          item.classList.remove("is-open");
          btn.setAttribute("aria-expanded", "false");
          content.style.maxHeight = "0px";
        } else {
          item.classList.add("is-open");
          btn.setAttribute("aria-expanded", "true");
          content.style.maxHeight = content.scrollHeight + "px";
        }
      });
    });
  }

  setupFAQ();
  document.addEventListener("astro:after-swap", setupFAQ);

  // ── Phase ──────────────────────────────────────────────────────────
  // The inline script in the head has already stamped data-pf-phase on
  // <html>, and the layout's CSS shows and hides data-phase elements from
  // it. What is left is the nav: on event day the bars are pinned from the
  // moment the page loads, and the page owes them the space.
  function applyPhase() {
    const phase = document.documentElement.dataset.pfPhase || "prep";
    const day = phase === "event";
    const nav = document.getElementById("pf-sectionnav");
    if (nav) nav.dataset.mode = day ? "day" : "pre";
    document.body.classList.toggle("pf-dayof", day);
  }

  applyPhase();
  document.addEventListener("astro:after-swap", applyPhase);

  // ── "On right now" ─────────────────────────────────────────────────
  // Reads the small JSON block the build left in the schedule section and
  // works out, in Eastern time, what is playing on each stage and which
  // fixed moment is next. Only ever asks Date.now(), so it can be tested by
  // overriding that. Runs on event day only; the panel stays hidden
  // otherwise.
  function setupClock() {
    const panel = document.getElementById("pf-now");
    const dataEl = document.getElementById("pf-schedule-data");
    if (!panel || !dataEl) return;
    type Set = {
      name: string;
      stage: string;
      slug: string;
      start: string;
      end: string;
    };
    type Moment = { start: string; time: string; title: string; area: string };
    type Data = {
      date: string;
      stages: { name: string; area: string }[];
      sets: Set[];
      moments: Moment[];
    };
    let data: Data;
    try {
      data = JSON.parse(dataEl.textContent || "");
    } catch {
      return;
    }
    const grid = panel.querySelector<HTMLElement>("[data-pf-now-grid]");
    const title = panel.querySelector<HTMLElement>("[data-pf-now-title]");
    const clock = panel.querySelector<HTMLElement>("[data-pf-clock]");
    const nextEl = panel.querySelector<HTMLElement>("[data-pf-now-next]");
    if (!grid || !title || !clock || !nextEl) return;

    // Eastern time, wherever the phone thinks it is
    const fmt = new Intl.DateTimeFormat("en-US", {
      timeZone: "America/New_York",
      hourCycle: "h23",
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
    });
    const eastern = () => {
      const p: Record<string, string> = {};
      fmt
        .formatToParts(new Date(Date.now()))
        .forEach((x) => (p[x.type] = x.value));
      const hour = p.hour === "24" ? "00" : p.hour;
      return {
        date: `${p.year}-${p.month}-${p.day}`,
        hm: `${hour}:${p.minute}`,
      };
    };
    const pretty = (hm: string) => {
      const [h, m] = hm.split(":").map(Number);
      const ap = h >= 12 ? "PM" : "AM";
      return `${((h + 11) % 12) + 1}:${String(m).padStart(2, "0")} ${ap}`;
    };
    const el = (tag: string, cls: string, text?: string) => {
      const e = document.createElement(tag);
      e.className = cls;
      if (text !== undefined) e.textContent = text;
      return e;
    };

    const firstStart = data.sets.map((x) => x.start).sort()[0];
    const lastEnd = data.sets
      .map((x) => x.end)
      .sort()
      .pop();
    const sets = (stage: string) =>
      data.sets
        .filter((x) => x.stage === stage)
        .sort((a, b) => a.start.localeCompare(b.start));

    function render() {
      const now = eastern();
      if (
        now.date !== data.date ||
        !data.sets.length ||
        !firstStart ||
        !lastEnd
      ) {
        panel.hidden = true;
        return;
      }
      panel.hidden = false;
      clock.textContent = pretty(now.hm);
      grid.replaceChildren();
      nextEl.hidden = true;
      nextEl.replaceChildren();

      // flag the live sets in the grid, and dim the moments that have passed
      document.querySelectorAll<HTMLElement>("[data-pf-set]").forEach((row) => {
        const set = data.sets.find((x) => x.slug === row.dataset.pfSet);
        const live = !!set && set.start <= now.hm && now.hm < set.end;
        if (live) row.setAttribute("data-pf-live", "");
        else row.removeAttribute("data-pf-live");
      });
      let soonMarked = false;
      document
        .querySelectorAll<HTMLElement>("[data-pf-moment]")
        .forEach((li) => {
          const start = li.dataset.pfMoment || "";
          const past = start < now.hm;
          if (past) li.setAttribute("data-pf-past", "");
          else li.removeAttribute("data-pf-past");
          if (!past && !soonMarked && start >= now.hm) {
            li.setAttribute("data-pf-soon", "");
            soonMarked = true;
          } else li.removeAttribute("data-pf-soon");
        });

      if (now.hm < firstStart) {
        title.textContent = "Not started yet";
        const openers = data.stages
          .map((st) => {
            const first = sets(st.name)[0];
            return first ? `${first.name} on ${st.name}` : "";
          })
          .filter(Boolean);
        grid.append(
          el(
            "p",
            "pf-now-empty",
            `Gates open at ${pretty(firstStart)}. First up: ${openers.join(
              ", ",
            )}.`,
          ),
        );
        return;
      }
      if (now.hm >= lastEnd) {
        title.textContent = "That's a wrap";
        grid.append(
          el(
            "p",
            "pf-now-empty",
            `The music is done for ${data.date.slice(
              0,
              4,
            )}. Thank you for coming.`,
          ),
        );
        return;
      }

      title.textContent = "On right now";
      data.stages.forEach((st) => {
        const list = sets(st.name);
        const live = list.find((x) => x.start <= now.hm && now.hm < x.end);
        const next = list.find((x) => x.start > now.hm);
        const stageLabel = st.area ? `${st.name} · ${st.area}` : st.name;
        if (live) {
          const row = el("a", "pf-now-row") as HTMLAnchorElement;
          row.href = `#${live.slug}`;
          row.dataset.pfState = "live";
          row.dataset.pfAct = live.name;
          row.dataset.pfStage = st.name;
          row.append(
            el("span", "pf-now-stage", stageLabel),
            el("span", "pf-now-act", live.name),
            el("span", "pf-now-when", `until ${pretty(live.end)}`),
          );
          grid.append(row);
        } else if (next) {
          const row = el("a", "pf-now-row") as HTMLAnchorElement;
          row.href = `#${next.slug}`;
          row.dataset.pfState = "next";
          row.dataset.pfAct = next.name;
          row.dataset.pfStage = st.name;
          row.append(
            el("span", "pf-now-stage", stageLabel),
            el("span", "pf-now-act", `Next: ${next.name}`),
            el("span", "pf-now-when", `at ${pretty(next.start)}`),
          );
          grid.append(row);
        } else {
          const row = el("div", "pf-now-row");
          row.dataset.pfState = "done";
          row.dataset.pfStage = st.name;
          row.append(
            el("span", "pf-now-stage", stageLabel),
            el("span", "pf-now-act", "Done for the day"),
          );
          grid.append(row);
        }
      });

      const moment = data.moments.find((m) => m.start >= now.hm);
      if (moment) {
        nextEl.hidden = false;
        const strong = el("strong", "", `${moment.time}: ${moment.title}`);
        nextEl.append("Up next: ", strong);
        if (moment.area) nextEl.append(` (${moment.area})`);
      }
    }

    render();
    const timer = window.setInterval(render, 30 * 1000);
    document.addEventListener("astro:before-swap", () => clearInterval(timer), {
      once: true,
    });
  }

  setupClock();
  document.addEventListener("astro:after-swap", setupClock);

  // ── Map tabs ───────────────────────────────────────────────────────
  // Only the first map has a src; the others carry data-src and get it the
  // first time their tab is opened. Arrow keys move between tabs.
  function setupMapTabs() {
    const view = document.getElementById("pf-mapview");
    if (!view) return;
    const tabs = Array.from(
      view.querySelectorAll<HTMLButtonElement>("[data-pf-maptab]"),
    );
    const panels = Array.from(
      view.querySelectorAll<HTMLElement>(".pf-mapview-panel"),
    );
    if (tabs.length !== panels.length) return;
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        t.setAttribute("aria-selected", i === j ? "true" : "false");
        t.tabIndex = i === j ? 0 : -1;
      });
      panels.forEach((p, j) => (p.hidden = i !== j));
      const img = panels[i].querySelector<HTMLImageElement>("img[data-src]");
      if (img && img.dataset.src) {
        img.src = img.dataset.src;
        delete img.dataset.src;
      }
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(i));
      t.addEventListener("keydown", (e) => {
        const delta =
          e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (!delta) return;
        e.preventDefault();
        select((i + delta + tabs.length) % tabs.length, true);
      });
    });
  }

  setupMapTabs();
  document.addEventListener("astro:after-swap", setupMapTabs);

  // ── Sponsor ad lightbox ────────────────────────────────────────────
  // The rail links straight to the full-size file, so without JavaScript a
  // tap still opens the ad. With it, the ad opens in place instead.
  function setupLightbox() {
    const box = document.getElementById("pf-lightbox");
    if (!box) return;
    const img = box.querySelector("img");
    const caption = box.querySelector<HTMLElement>(
      "[data-pf-lightbox-caption]",
    );
    const closeBtn = box.querySelector<HTMLButtonElement>(
      "[data-pf-lightbox-close]",
    );
    if (!img || !caption || !closeBtn) return;
    let last: HTMLElement | null = null;

    const close = () => {
      if (box.hidden) return;
      box.hidden = true;
      img.removeAttribute("src");
      document.body.style.overflow = "";
      last?.focus();
      last = null;
    };
    const open = (a: HTMLAnchorElement) => {
      last = a;
      img.src = a.href;
      img.alt = a.querySelector("img")?.alt || "";
      caption.textContent = a.dataset.pfAdCaption || "";
      box.hidden = false;
      document.body.style.overflow = "hidden";
      closeBtn.focus();
    };

    document.querySelectorAll<HTMLAnchorElement>("a[data-pf-ad]").forEach((a) =>
      a.addEventListener("click", (e) => {
        e.preventDefault();
        open(a);
      }),
    );
    closeBtn.addEventListener("click", close);
    box.addEventListener("click", (e) => {
      if (
        e.target === box ||
        e.target === box.querySelector(".pf-lightbox-body")
      )
        close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });
  }

  setupLightbox();
  document.addEventListener("astro:after-swap", setupLightbox);

  // ── Merch pre-sale deadline ────────────────────────────────────────
  // The build already leaves the pre-order buttons out once the deadline
  // has passed; this covers the hours between the deadline and the next
  // deploy, so the store never looks open when it is not.
  function applyPresaleDeadline() {
    const hero = document.querySelector<HTMLElement>(".pf-hero");
    const deadline = hero?.dataset.presaleDeadline;
    if (!deadline) return;
    if (Date.now() < new Date(deadline).getTime()) return;
    document
      .querySelectorAll<HTMLElement>("[data-pf-presale]")
      .forEach((el) => (el.hidden = true));
    document
      .querySelectorAll<HTMLElement>("[data-pf-presale-closed]")
      .forEach((el) => (el.hidden = false));
  }

  applyPresaleDeadline();
  document.addEventListener("astro:after-swap", applyPresaleDeadline);

  // ── Gallery "show more" ───────────────────────────────────────────
  // The extra photos are in the page but hidden, and a hidden lazy image
  // is never requested, so they cost nothing until someone asks for them.
  function setupGalleryMore() {
    const btn = document.querySelector<HTMLButtonElement>(
      "[data-pf-gallery-toggle]",
    );
    if (!btn) return;
    btn.addEventListener("click", () => {
      document
        .querySelectorAll<HTMLElement>("[data-pf-gallery-more]")
        .forEach((el) => (el.hidden = false));
      btn.setAttribute("aria-expanded", "true");
      btn.closest<HTMLElement>(".pf-gallery-more")?.remove();
    });
  }

  setupGalleryMore();
  document.addEventListener("astro:after-swap", setupGalleryMore);

  // ── Lazy sections vs. in-page jumps ───────────────────────────────
  // Sections below the fold skip layout and paint until they are scrolled
  // near (content-visibility: auto). Until a section has been laid out once
  // the browser only has a guessed height for it, and a jump to a section
  // further down inherits the error. Laying everything out once, then
  // letting the sections skip again, makes the browser remember each real
  // height, so later jumps land exactly. That happens in idle time after the
  // first paint, and on demand for any in-page link used before then.
  function settleLazySections(then?: () => void) {
    const root = document.documentElement;
    root.classList.add("pf-render-all");
    // the sizes are recorded at the end of a frame, so release a frame later
    requestAnimationFrame(() =>
      requestAnimationFrame(() => {
        root.classList.remove("pf-render-all");
        then?.();
      }),
    );
  }

  // A jump can land while fonts, icons and images are still arriving, and
  // any of those can reflow what sits above the target. After a jump,
  // re-check the target's position as they come in and nudge it back, but
  // only while the reader is still where the jump left them.
  const NAV_OFFSET = 60; // matches scroll-margin-top: nav height + 12px
  function keepAimed(el: Element) {
    const docTop = () => window.scrollY + el.getBoundingClientRect().top;
    let aimedY = Math.round(docTop() - NAV_OFFSET);
    const check = () => {
      if (Math.abs(window.scrollY - aimedY) > 8) return; // reader moved on
      if (Math.abs(el.getBoundingClientRect().top - NAV_OFFSET) < 4) return;
      settleLazySections(() => {
        el.scrollIntoView({ behavior: "instant" as ScrollBehavior });
        aimedY = Math.round(docTop() - NAV_OFFSET);
      });
    };
    setTimeout(check, 1500); // once the smooth scroll has finished
    setTimeout(check, 3500);
    document.fonts?.ready.then(() => setTimeout(check, 50));
    if (document.readyState !== "complete")
      window.addEventListener("load", () => setTimeout(check, 50), {
        once: true,
      });
  }

  function setupLazySections() {
    document.addEventListener(
      "click",
      (e) => {
        const a = (e.target as Element | null)?.closest?.('a[href^="#"]');
        if (!a) return;
        settleLazySections();
        let el: Element | null = null;
        try {
          el = document.querySelector(a.getAttribute("href") || "");
        } catch {
          el = null;
        }
        if (el) keepAimed(el);
      },
      true,
    );
    // Opened with a #section link: the browser already jumped using guessed
    // heights, so jump again once every section has its real one.
    let target: Element | null = null;
    try {
      target = location.hash ? document.querySelector(location.hash) : null;
    } catch {
      target = null;
    }
    if (target) {
      const el = target;
      settleLazySections(() => {
        el.scrollIntoView({ behavior: "instant" as ScrollBehavior });
        keepAimed(el);
      });
      return;
    }
    const w = window as Window & {
      requestIdleCallback?: (cb: () => void, o?: { timeout: number }) => void;
    };
    if (w.requestIdleCallback)
      w.requestIdleCallback(() => settleLazySections(), { timeout: 3000 });
    else setTimeout(() => settleLazySections(), 1500);
  }

  setupLazySections();
  document.addEventListener("astro:after-swap", setupLazySections);
</script>
