                <h3>
                  <i class="fa-solid fa-gavel" aria-hidden="true" /> Silent
                  Auction
                </h3>
                <ol class="pf-winners-list">
                  {auctionWinners.map((w) => (
                    <li class="pf-winners-row">
                      {w.prize && (
                        <span class="pf-winners-prize">{w.prize}</span>
                      )}
                      <span class="pf-winners-who">{w.winner}</span>
                    </li>
                  ))}
                </ol>
              </div>
            )}
          </div>

          {WINNERS_WHERE && (
            <p class="pf-winners-where">
              <i class="fa-solid fa-location-dot" aria-hidden="true" />{" "}
              {WINNERS_WHERE}
            </p>
          )}
          {WINNERS_NOTE && WINNERS_CLAIM_NOTE && (
            <p class="pf-winners-where">
              <i class="fa-solid fa-hourglass-end" aria-hidden="true" />{" "}
