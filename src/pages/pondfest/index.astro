                >
                  <i class="fa-solid fa-music" aria-hidden="true" /> By stage
                </button>
              </div>
            )}

            <div data-pf-view="stage">
              {hasLineup && (
                <div class="pf-sched-stages">
                  {stageColumns.map((col) => {
                    const stage = splitStage(col.name);
                    return (
                      <div class="pf-sched-stage">
