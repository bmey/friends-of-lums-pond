    color: rgba(255, 255, 255, 0.82);
  }
  .pf-plan-hashtags {
    text-align: center;
    margin: 1.5rem 0 0;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--pf-teal-light) !important;
  }

  /* ── Fundraising Goals ── */
  .pf-goals-section {
    padding-bottom: 0;
  }
  .pf-goals-intro {
    text-align: center;
    margin-bottom: clamp(2rem, 4vw, 4rem);
  }
  .pf-goals-intro .pf-btn {
    margin-top: 0.75rem;
  }
  .pf-goals-split {
    margin-top: clamp(2rem, 3vw, 3rem);
  }
  .pf-split-text h3 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    color: var(--pf-teal-light);
    margin-bottom: 1rem;
    font-weight: 700;
  }
  .pf-split-text p {
    font-size: clamp(0.95rem, 1.8vw, 1.1rem);
    line-height: 1.7;
    opacity: 0.88;
    margin-bottom: 1.5rem;
  }
  .pf-goals-donate-soon {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.45);
    font-style: italic;
  }

  /* ── What to Expect / amenity grid ── */
  .pf-expect-header {
    text-align: center;
    margin-bottom: clamp(2rem, 4vw, 3.25rem);
  }
  .pf-amen-intro {
    max-width: 720px;
    margin: 0 auto;
    font-size: clamp(0.95rem, 1.8vw, 1.1rem);
    line-height: 1.7;
  }

  .pf-amen-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3rem);
    max-width: 1180px;
    margin: 0 auto;
    align-items: start;
  }
  @media (min-width: 900px) {
    .pf-amen-grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: clamp(2rem, 4vw, 3.5rem);
      row-gap: clamp(2.5rem, 5vw, 4rem);
      /* the stagger below is a transform, so the last card in the
         right-hand column needs room to hang past the grid */
      padding-bottom: clamp(2.5rem, 5vw, 5rem);
    }
    /* staggered columns: the right column drops half a card */
    .pf-amen-card:nth-child(2n) {
      transform: translateY(clamp(2.5rem, 5vw, 5rem));
    }
  }

  .pf-amen-card {
    display: flex;
    flex-direction: column;
  }
  .pf-amen-media {
    aspect-ratio: 4 / 3;
    border-radius: 14px;
    overflow: hidden;
    background: var(--pf-light-alt);
    margin-bottom: 1.1rem;
  }
  .pf-amen-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .pf-amen-media-link {
    display: block;
    height: 100%;
  }
  .pf-amen-card:hover .pf-amen-media img {
    transform: scale(1.03);
  }
  /* cards with no photo yet: a tile carrying the icon at poster size */
  .pf-amen-media--icon {
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(
      135deg,
      var(--pf-purple) 0%,
      var(--pf-purple-dark) 55%,
      #1c1638 100%
    );
    position: relative;
  }
  .pf-amen-media--icon::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 78% 22%,
      rgba(94, 200, 195, 0.35),
      transparent 55%
    );
  }
  /* a ring behind the glyph, so the tile still reads as a designed
     panel rather than an empty block */
  .pf-amen-media--icon::before {
    content: "";
    position: absolute;
    width: clamp(6.5rem, 15vw, 9.5rem);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.05);
  }
  .pf-amen-media--icon i {
    font-size: clamp(2.75rem, 6vw, 4rem);
    color: rgba(255, 255, 255, 0.92);
    position: relative;
    z-index: 1;
  }

  .pf-amen-body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .pf-amen-title {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.55rem;
    font-size: clamp(1.15rem, 2.2vw, 1.5rem) !important;
    color: var(--pf-purple-dark) !important;
    margin: 0 !important;
    line-height: 1.25;
  }
  .pf-amen-title-icon {
    color: var(--pf-teal);
    font-size: 0.8em;
    flex-shrink: 0;
  }
  .pf-amen-badge {
    padding: 0.15em 0.6em;
    border-radius: 999px;
    background: var(--pf-purple);
    color: #fff;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    white-space: nowrap;
    align-self: center;
  }
  .pf-amen-desc {
    font-size: clamp(0.92rem, 1.6vw, 1rem);
    line-height: 1.6;
    color: #4a3d6b;
    margin: 0;
    max-width: 46ch;
  }
  .pf-amen-area {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45em;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--pf-purple);
    margin-top: 0.2rem;
  }
  .pf-amen-area i {
    color: var(--pf-teal);
    font-size: 0.9em;
  }

  /* ── the logistics strip under the grid ── */
  .pf-everywhere {
    background: #fff;
    border: 1px solid rgba(61, 47, 122, 0.14);
    border-radius: 12px;
    padding: clamp(1.1rem, 2.5vw, 1.75rem);
    margin: clamp(1rem, 2vw, 2rem) auto 0;
    max-width: 1180px;
  }
  .pf-everywhere-label {
    font-size: 0.72rem !important;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--pf-purple) !important;
    margin-bottom: 0.9rem !important;
  }
  .pf-everywhere-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem 1.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .pf-everywhere-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .pf-everywhere-list {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .pf-everywhere-list li {
    display: flex;
    align-items: baseline;
    gap: 0.6em;
    font-size: 0.9rem;
    color: #3a2e5a;
    line-height: 1.45;
  }
  .pf-everywhere-list i {
    color: var(--pf-teal);
    flex-shrink: 0;
  }
  .pf-amen-footnote {
    text-align: center;
    font-size: 0.9rem;
    margin: 1.25rem auto 0;
  }
  .pf-amen-footnote a {
    color: var(--pf-purple);
    font-weight: 700;
  }

  .pf-amen-figure {
    margin: 0 0 1.1rem;
  }
  .pf-amen-figure .pf-amen-media {
    margin-bottom: 0;
  }
  .pf-amen-credit {
    display: block;
    margin-top: 0.45rem;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: rgba(58, 46, 90, 0.6);
  }
  .pf-amen-credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .pf-amen-credit a:hover {
    color: var(--pf-purple);
  }
  .pf-amen-title-link {
    color: inherit;
    text-decoration: none;
    border-bottom: 2px solid var(--pf-teal);
  }
  .pf-amen-title-link:hover {
    color: var(--pf-purple);
  }
  .pf-amen-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    margin-top: 0.2rem;
  }
  /* times are read, not shouted, so they opt out of the chip's caps */
  .pf-amen-time {
    color: var(--pf-purple-dark);
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: 0.76rem;
    font-weight: 600;
  }

  /* ── Sponsor and supporter disclosure ── */
  .pf-disclosure .pf-disclosure-title {
    font-size: clamp(1.15rem, 2.2vw, 1.5rem) !important;
    margin-bottom: 1rem;
  }
  .pf-disclosure p {
    font-size: 0.85rem !important;
    line-height: 1.7;
    max-width: 68ch;
    color: rgba(255, 255, 255, 0.62) !important;
  }
  .pf-disclosure a {
    color: var(--pf-teal-light);
  }

  /* ── Music Lineup ── */
  .pf-lineup-header,
  .pf-coming-soon {
    text-align: center;
  }
  .pf-lineup-intro {
    max-width: 720px;
    margin: 0.75rem auto 0;
    font-size: clamp(0.92rem, 1.7vw, 1.02rem);
    line-height: 1.7;
  }
  .pf-lineup-intro a {
    color: var(--pf-teal);
    text-decoration: none;
  }
  .pf-lineup-intro a:hover {
    text-decoration: underline;
  }
  .pf-coming-soon {
    padding: clamp(1rem, 3vw, 3rem) 0;
  }
  .pf-coming-soon-headline {
    font-family: var(--font-header);
    font-size: clamp(2rem, 5vw, 3.8rem);
    color: var(--pf-teal-light);
    margin: 0.25rem 0 1rem;
    letter-spacing: 0.02em;
  }
  .pf-coming-soon-line {
    width: 60px;
    height: 3px;
    background: var(--pf-teal);
    margin: 0 auto 1.25rem;
    border-radius: 2px;
  }
  .pf-coming-soon p {
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    opacity: 0.78;
    max-width: 480px;
    margin: 0 auto;
  }
  .pf-coming-soon p a {
    color: var(--pf-teal);
    text-decoration: none;
  }
  .pf-coming-soon p a:hover {
    text-decoration: underline;
  }
  .pf-lineup-list {
    --pf-act-pad: clamp(1.25rem, 2.6vw, 2.25rem);
    /* how far the photo hangs above the panel */
    --pf-act-lift: clamp(2rem, 4vw, 3.5rem);
    /* how tall a photo stands, whatever shape it is — width follows from
       its own aspect ratio, so nothing gets cropped to fit a common box */
    --pf-act-h: clamp(14rem, 24vw, 20rem);
    max-width: 1120px;
    margin: clamp(3rem, 6vw, 5rem) auto 0;
    display: grid;
    /* stays comfortably clear of the photo lifting out of the next panel */
    gap: clamp(3.5rem, 7vw, 6rem);
  }

  /* One act = a raised panel with the photo breaking out of its top edge,
     flipping side to side down the page. */
  .pf-act {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.75rem);
    padding: var(--pf-act-pad);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.09);
  }
  /* A hairline of colour along the top, alternating with the photo side */
  .pf-act::before {
    content: "";
    position: absolute;
    inset: -1px; /* sit over the panel's own border, not inside it */
    border-radius: 17px; /* concentric with the panel's 16px */
    background: linear-gradient(
        90deg,
        var(--pf-teal) 0%,
        var(--pf-purple-light) 100%
      )
      top / 100% 3px no-repeat;
    opacity: 0.75;
    pointer-events: none;
  }
  .pf-act--flip::before {
    background-image: linear-gradient(
      90deg,
      var(--pf-purple-light) 0%,
      var(--pf-teal) 100%
    );
  }
  .pf-act--flip {
    grid-template-columns: minmax(0, 1fr) auto;
  }
  .pf-act--flip .pf-act-media {
    order: 2;
  }

  .pf-act-media {
    position: relative;
    align-self: start;
    margin-top: calc(-1 * (var(--pf-act-pad) + var(--pf-act-lift)));
    width: clamp(10rem, calc(var(--pf-act-ar, 1.333) * var(--pf-act-h)), 30rem);
    aspect-ratio: var(--pf-act-ar, 4 / 3);
    border-radius: 12px;
    overflow: hidden;
    background: linear-gradient(
      135deg,
      var(--pf-purple-dark) 0%,
      var(--pf-purple) 55%,
      var(--pf-teal) 100%
    );
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pf-act-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .pf-act-monogram {
    font-family: var(--font-header);
    font-size: clamp(3rem, 8vw, 5.5rem);
    line-height: 1;
    color: rgba(255, 255, 255, 0.85);
  }

  .pf-act-body {
    min-width: 0;
    max-width: 40rem;
  }
  .pf-act-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.6rem;
  }
  .pf-act-stage {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #fff;
    background: var(--pf-teal);
    padding: 0.15em 0.6em;
    border-radius: 4px;
  }
  .pf-act-time {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.6);
  }
  .pf-act-name {
    font-family: var(--font-header);
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    line-height: 1.1;
    letter-spacing: 0.01em;
    color: #fff;
    margin: 0 0 0.6rem;
  }
  .pf-act-blurb {
    font-size: clamp(0.92rem, 1.6vw, 1rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.72);
    margin: 0;
  }
  .pf-act-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.1rem;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    border: 1px solid rgba(42, 196, 179, 0.5);
    color: var(--pf-teal-light);
    background: rgba(42, 196, 179, 0.08);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }
  .pf-act-link:hover,
  .pf-act-link:focus-visible {
    background: var(--pf-teal);
    border-color: var(--pf-teal);
    color: var(--pf-dark);
  }

  /* Phones: photo goes full-bleed across the top of the panel, words below */
  @media (max-width: 820px) {
    .pf-act,
    .pf-act--flip {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .pf-act::before {
      display: none;
    }
    .pf-act--flip .pf-act-media {
      order: 0;
    }
    .pf-act-media {
      width: auto;
      max-width: none;
      margin: calc(-1 * var(--pf-act-pad)) calc(-1 * var(--pf-act-pad))
        var(--pf-act-pad);
      border-radius: 15px 15px 0 0;
      box-shadow: none;
    }
    .pf-act-body {
      max-width: none;
    }
  }

  .pf-emcee-strip {
    max-width: 720px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    margin-top: clamp(1.25rem, 3vw, 2rem);
    padding: 1rem 1.25rem;
    border-radius: 999px;
    background: rgba(42, 196, 179, 0.12);
    border: 1px solid rgba(42, 196, 179, 0.35);
    text-align: center;
  }
  .pf-emcee-strip i {
    color: var(--pf-teal);
    font-size: 1.1rem;
    flex-shrink: 0;
  }
  .pf-emcee-strip span {
    font-size: clamp(0.92rem, 1.8vw, 1.05rem);
    font-weight: 700;
    color: #fff;
  }

  /* ── 75th anniversary ── */
  .pf-75th-media {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.5rem, 4vw, 3.5rem);
    box-sizing: border-box;
    background: var(--pf-dark);
  }
  .pf-75th-figure {
    margin: 0;
    width: 100%;
  }
  .pf-75th-figure figcaption {
    margin-top: 0.75rem;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.5;
  }
  .pf-75th-text {
    position: relative;
  }
  .pf-75th-corner-logo {
    position: absolute;
    top: clamp(1.25rem, 3vw, 2.5rem);
    right: clamp(1.25rem, 3vw, 2.5rem);
    width: 110px;
    max-width: 160px;
    height: auto;
    opacity: 0.75;
  }
  .pf-75th-text h2 {
    font-size: clamp(1.9rem, 4vw, 3rem) !important;
  }
  .pf-75th-link {
    align-self: flex-start;
    color: var(--pf-teal-light);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid rgba(77, 217, 203, 0.4);
  }
  .pf-75th-link:hover {
    border-bottom-color: var(--pf-teal-light);
  }
  @media (max-width: 520px) {
    .pf-75th-corner-logo {
      position: static;
      display: block;
      margin-bottom: 1rem;
      opacity: 0.85;
    }
  }

  /* ── Get Involved ── */
  .pf-involved-header {
    text-align: center;
    margin-bottom: clamp(1.5rem, 3vw, 3rem);
  }
  .pf-involved-grid {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 860px) {
    .pf-involved-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .pf-involved-card {
    text-align: center;
    padding: clamp(1.25rem, 2.5vw, 2rem) 1rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    height: 100%;
    box-sizing: border-box;
  }
  .pf-involved-card .pf-btn {
    width: 100%;
    text-align: center;
    white-space: normal;
    word-break: break-word;
    box-sizing: border-box;
  }
  .pf-involved-icon {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    color: var(--pf-teal-light);
    margin-bottom: 0.25rem;
  }
  .pf-involved-card h3 {
    color: #fff;
    font-size: 1rem;
    margin: 0;
  }
  .pf-involved-card p {
    font-size: 0.85rem;
    opacity: 0.72;
    margin: 0;
    line-height: 1.4;
    flex: 1;
  }
  .pf-involved-more {
    text-align: center;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  /* ── Sponsors ── */
  .pf-sponsors-inner {
    text-align: center;
  }
  .pf-sponsor-tiers {
    margin-top: 2rem;
  }
  .pf-sponsor-tier {
    margin-bottom: 1.5rem;
  }
  .pf-sponsor-tier-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--pf-teal);
    font-weight: 700;
    margin-bottom: 0.6rem;
  }
  .pf-sponsor-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: center;
  }
  .pf-sponsor-tier:nth-child(1) .pf-sponsor-name {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--pf-purple-dark);
  }
  .pf-sponsor-tier:nth-child(2) .pf-sponsor-name {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--pf-purple);
  }
  .pf-sponsor-tier:nth-child(n + 3) .pf-sponsor-name {
    font-size: 0.95rem;
    color: #3a2e5a;
  }
  .pf-sponsor-name {
    text-decoration: none;
  }
  a.pf-sponsor-name:hover {
    color: var(--pf-teal);
    text-decoration: underline;
  }
  .pf-sponsor-cta {
    margin-top: 1.25rem;
    font-size: 0.95rem;
  }
  .pf-sponsor-cta a {
    color: var(--pf-purple);
    font-weight: 700;
  }
  .pf-sponsor-empty {
    margin-top: 1.5rem;
    font-size: 1rem;
    color: #3a2e5a;
  }
  .pf-sponsor-empty a {
    color: var(--pf-purple);
  }

  /* ── FAQ ── */
  .pf-faq-layout {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    grid-template-columns: 1fr;
    align-items: start;
  }
  @media (min-width: 768px) {
    .pf-faq-layout {
      grid-template-columns: 35% 1fr;
    }
  }
  .pf-faq-intro h2 {
    margin-bottom: 0.75rem;
  }
  .pf-faq-intro p {
    font-size: clamp(0.9rem, 1.8vw, 1rem);
    line-height: 1.65;
    margin: 0;
  }
  .pf-faq-intro p a {
    color: var(--pf-teal);
    text-decoration: none;
  }
  .pf-faq-intro p a:hover {
    text-decoration: underline;
  }
  .pf-press-link {
    margin-top: 1rem !important;
    font-size: 0.9rem !important;
    color: rgba(255, 255, 255, 0.6) !important;
  }
  .pf-faq {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .pf-faq-item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
