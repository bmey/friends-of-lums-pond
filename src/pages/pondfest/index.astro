                      class="fa-solid fa-arrow-up-right-from-square"
                      aria-hidden="true"
                    />
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </section>
    )
  }

  <!-- ══ WHAT TO EXPECT — one card per amenity, photo led ══════════ -->
  <section class="pf-section pf-section--light pf-section--lazy" id="pf-expect">
    <div class="pf-section-inner">
