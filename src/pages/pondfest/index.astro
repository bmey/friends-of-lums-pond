---
import Layout from "../../layouts/PondFestLayout.astro";
import PondFestCountdown from "../../components/pondfest/PondFestCountdown.astro";
import PondFestVideo from "../../components/pondfest/PondFestVideo.astro";
import EmailCTAModal from "../../components/pondfest/EmailCTAModal.astro";
import {
  CURRENT_YEAR,
  EVENT_DATE,
  EVENT_DATE_DISPLAY,
  EVENT_TIME,
  EVENT_LOCATION,
  EVENT_TAGLINE,
  FUNDRAISING_GOAL,
  HERO_IMAGE_URL,
  HERO_IMAGE_MOBILE_URL,
  OG_IMAGE_URL,
  MERCH_URL,
  PONDFEST_DONATE_URL,
  VOLUNTEER_URL,
  SPONSOR_URL,
  VENDOR_URL,
  PONDFEST_EMAIL,
  FACEBOOK_URL,
  HASHTAGS,
  LINEUP,
  EMCEES,
  SPONSORS,
  FUNDING_GOALS,
  AMENITIES,
  AMENITIES_INTRO,
  EVERY_AREA,
  SUPPORT_DISCLOSURE,
  SUPPORT_DISCLOSURE_TITLE,
  FAQ,
  DAY_OF_ALERT,
  SHUTTLE_INFO,
  PARKING_NOTES,
  FEE_NOTE,
  BRING_NOTE,
  RAIN_DATE_NOTE,
  RAFFLE_LINK,
  AUCTION_LINK,
  FEEDBACK_LINK,
  EVENT_MAP_IMAGE_URL,
  EVENT_MAP_FULL_URL,
  PARKING_MAP_IMAGE_URL,
  VENDOR_MAP_IMAGE_URL,
  PHOTO_BAND_1_URL,
  PHOTO_BAND_1_MOBILE_URL,
  GALLERY_PHOTOS,
  PHOTO_CREDIT_NAME,
  PHOTO_CREDIT_URL,
  HISTORY_BG_PHOTO,
  SEVENTY_FIFTH_URL,
  SEVENTY_FIFTH_LOGO_WHITE,
  HEART_OF_PARKS_VIDEO_URL,
  HEART_OF_PARKS_POSTER_URL,
  HEART_OF_PARKS_CAPTIONS_URL,
} from "../../data/pondfest/config";

const hasMaps =
  EVENT_MAP_IMAGE_URL || PARKING_MAP_IMAGE_URL || VENDOR_MAP_IMAGE_URL;

const sponsorsByTier = {
  diamond: SPONSORS.filter((s) => s.tier === "diamond"),
  platinum: SPONSORS.filter((s) => s.tier === "platinum"),
  gold: SPONSORS.filter((s) => s.tier === "gold"),
  silver: SPONSORS.filter((s) => s.tier === "silver"),
  bronze: SPONSORS.filter((s) => s.tier === "bronze"),
  family: SPONSORS.filter((s) => s.tier === "family"),
};

const hasSponsors = SPONSORS.length > 0;
const hasLineup = LINEUP.length > 0;

// Hero CTAs. Entries without a link are dropped rather than rendered
// disabled — the hero never shows a dead button.
const ctaLinks = [
  {
    label: "Donate",
    url: PONDFEST_DONATE_URL,
    style: "pf-btn--primary",
    icon: "fa-circle-dollar-to-slot",
  },
  {
    label: "Pre-Order Shirts",
    url: MERCH_URL,
    style: "pf-btn--outline-light",
    icon: "fa-shirt",
  },
  {
    label: "Volunteer",
    url: VOLUNTEER_URL,
    style: "pf-btn--outline-light",
    icon: "fa-hand-holding-heart",
  },
  {
    label: "Sponsor",
    url: SPONSOR_URL,
    style: "pf-btn--outline-light",
    icon: "fa-star",
  },
  {
    label: "Vend",
    url: VENDOR_URL,
    style: "pf-btn--outline-light",
    icon: "fa-store",
  },
  {
    label: "Perform",
    useEmailModal: true,
    style: "pf-btn--outline-light",
    icon: "fa-music",
  },
].filter((cta) => ("useEmailModal" in cta && cta.useEmailModal) || cta.url);

// "Plan Your Visit" info notes — order matters, fees first
const planNotes = [
  { icon: "fa-ticket", text: FEE_NOTE },
  { icon: "fa-square-parking", text: PARKING_NOTES },
  { icon: "fa-bus", text: SHUTTLE_INFO },
  { icon: "fa-bag-shopping", text: BRING_NOTE },
  { icon: "fa-cloud-rain", text: RAIN_DATE_NOTE },
].filter((n) => n.text);

const involvedPaths = [
  {
    icon: "fa-hand-holding-heart",
    title: "Volunteer",
    desc: "Help make Pond Fest happen. We need hands for setup, Junior Jam, info tables, and more.",
    url: VOLUNTEER_URL,
    cta: "Sign Up to Volunteer",
  },
  {
    icon: "fa-guitar",
    title: "Perform",
    desc: "Are you a local musician or performer? We want to hear from you.",
    useEmailModal: true,
    cta: "Apply to Perform",
  },
  {
    icon: "fa-store",
    title: "Vend",
    desc: "Bring your business or craft to Pond Fest and connect with the community.",
    url: VENDOR_URL,
    cta: "Apply to Vend",
  },
  {
    icon: "fa-star",
    title: "Sponsor",
    desc: "Support the park and get visibility with thousands of attendees.",
    url: SPONSOR_URL,
    cta: "Become a Sponsor",
  },
];

const tierLabels: Record<string, string> = {
  diamond: "Diamond Sponsors",
  platinum: "Platinum Sponsors",
  gold: "Gold Sponsors",
  silver: "Silver Sponsors",
  bronze: "Bronze Sponsors",
  family: "Family Sponsors",
};

// Photo credit for one amenity card. An unset `credit` means the house
// photographer; an empty string means we do not know and would rather say
// nothing than guess.
const amenityCredit = (a: (typeof AMENITIES)[number]) => {
  if (a.credit === undefined)
    return { name: PHOTO_CREDIT_NAME, url: PHOTO_CREDIT_URL };
  if (a.credit === "") return null;
  return { name: a.credit, url: a.creditUrl };
};

// Monogram fallback for acts with no photo — "The Sarah Koon Band" -> S
const monogram = (name: string) =>
  name
    .replace(/^the\s+/i, "")
    .charAt(0)
    .toUpperCase();

// Amenity links that point elsewhere on this page open in the same tab
const isOnPageLink = (url: string) => url.startsWith("#");

// Label the "hear more" button on an act card after wherever it points
const actLink = (url: string) => {
  const host = new URL(url).hostname.replace(/^www\./, "");
  if (host.includes("facebook"))
    return { icon: "fa-brands fa-facebook-f", label: "Facebook" };
  if (host.includes("instagram"))
    return { icon: "fa-brands fa-instagram", label: "Instagram" };
  if (host.includes("bandcamp"))
    return { icon: "fa-brands fa-bandcamp", label: "Bandcamp" };
  if (host.includes("youtube"))
    return { icon: "fa-brands fa-youtube", label: "YouTube" };
  if (host.includes("spotify"))
    return { icon: "fa-brands fa-spotify", label: "Spotify" };
  return { icon: "fa-solid fa-arrow-up-right-from-square", label: "Website" };
};

const emceeNames = EMCEES.map((e) => e.name);
const emceeLine =
  emceeNames.length > 1
    ? `${emceeNames.slice(0, -1).join(", ")} & ${
        emceeNames[emceeNames.length - 1]
      }`
    : emceeNames[0];
---

<Layout
  title={`Pond Fest ${CURRENT_YEAR} | Friends of Lums Pond`}
  description={`Pond Fest ${CURRENT_YEAR}. ${EVENT_DATE_DISPLAY}, Lums Pond State Park. Free community festival: live music on three stages, beer garden, food trucks, kids' activities, and more. Standard park entrance fee applies.`}
  ogImage={OG_IMAGE_URL}
>
  <!-- ══ ALERT BANNER ════════════════════════════════════════════════ -->
  {
    DAY_OF_ALERT && (
      <div class="pf-alert-banner" role="alert">
        <i class="fa-solid fa-circle-info" />
        {DAY_OF_ALERT}
      </div>
    )
  }

  <!-- ══ HERO ═══════════════════════════════════════════════════════ -->
  <section
    class="pf-hero"
    style={`--pf-hero-img: url('${HERO_IMAGE_URL}'); --pf-hero-img-sm: url('${
      HERO_IMAGE_MOBILE_URL || HERO_IMAGE_URL
    }')`}
  >
    <div class="pf-hero-overlay">
      <div class="pf-hero-content">
        <div class="pf-hero-eyebrow">Friends of Lums Pond presents</div>
        <h1 class="pf-hero-title">
          Pond Fest <span class="pf-hero-year">{CURRENT_YEAR}</span>
        </h1>
        <p class="pf-hero-meta">
          <span class="pf-nowrap">
            <i class="fa-solid fa-calendar-days"></i>
            {EVENT_DATE_DISPLAY}
          </span>
          <span class="pf-hero-meta-sep">&nbsp;&middot;&nbsp;</span>
          <span class="pf-nowrap">
            <i class="fa-solid fa-clock"></i>
            {EVENT_TIME}
          </span>
          <br />
          <span class="pf-nowrap">
            <i class="fa-solid fa-location-dot"></i>
            {EVENT_LOCATION}
          </span>
        </p>
        <p class="pf-hero-tagline">{EVENT_TAGLINE}</p>
        <p class="pf-hero-free">
          Free to attend &middot; standard park entrance fee applies ($5 DE /
          $10 out-of-state vehicles)
        </p>
        <PondFestCountdown startDate={EVENT_DATE} year={CURRENT_YEAR} />
        <div class="pf-hero-ctas">
          {
            ctaLinks.map((cta) =>
              "useEmailModal" in cta && cta.useEmailModal ? (
                <button
                  type="button"
                  class={`pf-btn ${cta.style}`}
                  data-open-modal="performModal"
                >
                  <i class={`fa-solid ${cta.icon}`} />
                  {cta.label}
                </button>
              ) : (
                <a
                  href={cta.url}
                  class={`pf-btn ${cta.style}`}
                  target="_blank"
                  rel="noopener"
                >
                  <i class={`fa-solid ${cta.icon}`} />
                  {cta.label}
                </a>
              ),
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ══ 75th STRIP — sits under the hero so the hero stays short ═══ -->
  <a class="pf-75th-strip" href="#pf-75th">
    <img
      src={SEVENTY_FIFTH_LOGO_WHITE}
      alt="Delaware State Parks 75th anniversary"
      width="120"
      loading="lazy"
    />
    <span>Celebrating 75 Years of Delaware State Parks</span>
  </a>

  <!-- ══ DAY-OF PANEL — thin toolbar, shown the week of the event ════ -->
  <div
    id="pf-day-of-panel"
    data-event-date={EVENT_DATE}
    style="display:none"
    class="pf-day-of-panel"
  >
    <!-- Quick navigation -->
    <section class="pf-section pf-section--purple">
      <div class="pf-section-inner pf-section-inner--mid">
        <h2>Day-of Quick Links</h2>
        <div class="pf-dayof-quicknav">
          <a href="#pf-plan" class="pf-quicknav-btn">
            <i class="fa-solid fa-map"></i> Plan Your Visit
          </a>
          {
            RAFFLE_LINK && (
              <a
                href={RAFFLE_LINK}
                target="_blank"
                rel="noopener"
                class="pf-quicknav-btn"
              >
                <i class="fa-solid fa-ticket" /> Raffles
              </a>
            )
          }
          {
            AUCTION_LINK && (
              <a
                href={AUCTION_LINK}
                target="_blank"
                rel="noopener"
                class="pf-quicknav-btn"
              >
                <i class="fa-solid fa-gavel" /> Auction
              </a>
            )
          }
          <a
            href={PONDFEST_DONATE_URL}
            target="_blank"
            rel="noopener"
            class="pf-quicknav-btn"
          >
            <i class="fa-solid fa-circle-dollar-to-slot"></i> Donate
          </a>
          {
            FEEDBACK_LINK && (
              <a
                href={FEEDBACK_LINK}
                target="_blank"
                rel="noopener"
                class="pf-quicknav-btn"
              >
                <i class="fa-solid fa-comment-dots" /> Feedback
              </a>
            )
          }
        </div>
      </div>
    </section>

    {
      (RAFFLE_LINK || AUCTION_LINK) && (
        <section class="pf-section pf-section--dark">
          <div class="pf-section-inner pf-section-inner--mid">
            <h2>Raffles &amp; Auction</h2>
            <div class="pf-dayof-link-cards">
              {RAFFLE_LINK && (
                <a
                  href={RAFFLE_LINK}
                  target="_blank"
                  rel="noopener"
                  class="pf-dayof-link-card"
                >
                  <i class="fa-solid fa-ticket pf-dayof-link-icon" />
                  <div>
                    <strong>Raffle Info &amp; Results</strong>
                    <p>View raffle items and winner announcements</p>
                  </div>
                  <i class="fa-solid fa-arrow-right pf-dayof-link-arrow" />
                </a>
              )}
              {AUCTION_LINK && (
                <a
                  href={AUCTION_LINK}
                  target="_blank"
                  rel="noopener"
                  class="pf-dayof-link-card"
                >
                  <i class="fa-solid fa-gavel pf-dayof-link-icon" />
                  <div>
                    <strong>Silent Auction</strong>
                    <p>View auction items and place or check bids</p>
                  </div>
                  <i class="fa-solid fa-arrow-right pf-dayof-link-arrow" />
                </a>
              )}
            </div>
          </div>
        </section>
      )
    }

    {
      FEEDBACK_LINK && (
        <section class="pf-section pf-section--purple">
          <div class="pf-section-inner--narrow pf-feedback-section">
            <h2>Share Your Feedback</h2>
            <p>
              Thank you for spending the day with us at Pond Fest! Your feedback
              helps us make next year even better. It only takes two minutes.
            </p>
            <a
              href={FEEDBACK_LINK}
              target="_blank"
              rel="noopener"
              class="pf-btn pf-btn--outline-light"
            >
              <i class="fa-solid fa-comment-dots" /> Go to Survey
            </a>
          </div>
        </section>
      )
    }
  </div>
  <!-- ══ END DAY-OF PANEL ═══════════════════════════════════════════ -->

  <!-- ══ FUNDRAISING GOALS — split image+text on purple ════════════ -->
  {
    FUNDING_GOALS.length > 0 && (
      <section class="pf-section pf-section--purple pf-goals-section">
        <div class="pf-section-inner pf-section-inner--narrow pf-goals-intro">
          <span class="pf-eyebrow">Fundraising for {CURRENT_YEAR}</span>
          <h2>Raising {FUNDRAISING_GOAL} for the Park</h2>
          <p>
            Money raised goes directly to funding or enhancing Lums Pond State
            Park programs and facilities.
          </p>
          <p>
            Since 2024, Pond Fest has raised about $30,000 for the park. This
            year's goal: match it in a single day.
          </p>
          <a
            href={PONDFEST_DONATE_URL}
            class="pf-btn pf-btn--primary"
            target="_blank"
            rel="noopener"
          >
            <i class="fa-solid fa-circle-dollar-to-slot" /> Donate to Pond Fest{" "}
            {CURRENT_YEAR}
          </a>
        </div>

        {FUNDING_GOALS.map((goal, i) => (
          <div
            class={`pf-split ${
              i % 2 !== 0 ? "pf-split--reverse" : ""
            } pf-goals-split`}
          >
            <div class="pf-split-media">
              {goal.imageUrl ? (
                <img src={goal.imageUrl} alt={goal.name} loading="lazy" />
              ) : (
                <div class="pf-img-placeholder">
                  <i class="fa-solid fa-camera" />
                </div>
              )}
            </div>
            <div class="pf-split-text">
              <h3>{goal.name}</h3>
              <p>{goal.description}</p>
              {goal.donorboxUrl ? (
                <a
                  href={goal.donorboxUrl}
                  class="pf-btn pf-btn--primary"
                  target="_blank"
                  rel="noopener"
                >
                  Donate
                </a>
              ) : (
                <span class="pf-goals-donate-soon">
                  Donation link coming soon
                </span>
              )}
            </div>
          </div>
        ))}
      </section>
    )
  }

  <!-- ══ WHAT TO EXPECT — one card per amenity, photo led ══════════ -->
  <section class="pf-section pf-section--light">
    <div class="pf-section-inner">
      <div class="pf-expect-header">
        <span class="pf-eyebrow">The Experience</span>
        <h2>What to Expect</h2>
        <p class="pf-amen-intro">{AMENITIES_INTRO}</p>
      </div>

      <div class="pf-amen-grid">
        {
          AMENITIES.map((a) => (
            <article
              class={`pf-amen-card ${
                a.imageUrl ? "" : "pf-amen-card--nophoto"
              }`}
              id={a.id}
            >
              {a.imageUrl ? (
                <figure class="pf-amen-figure">
                  <div class="pf-amen-media">
                    {a.url && isOnPageLink(a.url) ? (
                      <a href={a.url} class="pf-amen-media-link" tabindex="-1">
                        <img
                          src={a.imageUrl}
                          alt={a.imageAlt || a.title}
                          loading="lazy"
                          decoding="async"
                        />
                      </a>
                    ) : (
                      <img
                        src={a.imageUrl}
                        alt={a.imageAlt || a.title}
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                  </div>
                  {amenityCredit(a) && (
                    <figcaption class="pf-amen-credit">
                      Photo:{" "}
                      {amenityCredit(a)!.url ? (
                        <a
                          href={amenityCredit(a)!.url}
                          target="_blank"
                          rel="noopener"
                        >
                          {amenityCredit(a)!.name}
                        </a>
                      ) : (
                        amenityCredit(a)!.name
                      )}
                    </figcaption>
                  )}
                </figure>
              ) : (
                <div
                  class="pf-amen-media pf-amen-media--icon"
                  aria-hidden="true"
                >
                  <i class={`fa-solid ${a.icon}`} />
                </div>
              )}
              <div class="pf-amen-body">
                <h3 class="pf-amen-title">
                  <i
                    class={`fa-solid ${a.icon} pf-amen-title-icon`}
                    aria-hidden="true"
                  />
                  {a.url ? (
                    <a
                      href={a.url}
                      target={isOnPageLink(a.url) ? undefined : "_blank"}
                      rel={isOnPageLink(a.url) ? undefined : "noopener"}
                      class="pf-amen-title-link"
                    >
                      {a.title}
                    </a>
                  ) : (
                    <span>{a.title}</span>
                  )}
                  {a.badge && <span class="pf-amen-badge">{a.badge}</span>}
                </h3>
                <p class="pf-amen-desc">{a.desc}</p>
                <div class="pf-amen-meta">
                  <span class="pf-amen-area">
                    <i class="fa-solid fa-location-dot" aria-hidden="true" />
                    {a.area}
                  </span>
                  {a.time && (
                    <span class="pf-amen-area pf-amen-time">
                      <i class="fa-solid fa-clock" aria-hidden="true" />
                      {a.time}
                    </span>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>

      {
        EVERY_AREA.length > 0 && (
          <div class="pf-everywhere">
            <h3 class="pf-everywhere-label">In every area</h3>
            <ul class="pf-everywhere-list">
              {EVERY_AREA.map((item) => (
                <li>
                  <i class={`fa-solid ${item.icon}`} />
                  <span>{item.title}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <p class="pf-amen-footnote">
        Not sure where anything is? <a href="#pf-plan">Plan Your Visit</a> has
        the event map.
      </p>
    </div>
  </section>

  <!-- ══ PLAN YOUR VISIT — map + logistics, always on ══════════════ -->
  <section class="pf-section pf-section--dark-alt" id="pf-plan">
    <div class="pf-section-inner pf-section-inner--mid">
      <div class="pf-plan-header">
        <span class="pf-eyebrow">Before You Go</span>
        <h2>Plan Your Visit</h2>
      </div>
      {
        hasMaps && (
          <div class="pf-maps-grid">
            {EVENT_MAP_IMAGE_URL && (
              <div class="pf-map-item pf-map-item--event">
                <h3>Event Map</h3>
                <a
                  href={EVENT_MAP_FULL_URL || EVENT_MAP_IMAGE_URL}
                  target="_blank"
                  rel="noopener"
                >
                  <img
                    src={EVENT_MAP_IMAGE_URL}
                    alt="Pond Fest event map showing Areas 1, 2 and 3 at Lums Pond State Park"
                    class="pf-map-img"
                    loading="lazy"
                  />
                  <span class="pf-map-tap-hint">
                    <i class="fa-solid fa-magnifying-glass-plus" /> Tap to
                    enlarge
                  </span>
                </a>
              </div>
            )}
            {PARKING_MAP_IMAGE_URL && (
              <div class="pf-map-item">
                <h3>Parking Map</h3>
                <a href={PARKING_MAP_IMAGE_URL} target="_blank" rel="noopener">
                  <img
                    src={PARKING_MAP_IMAGE_URL}
                    alt="Pond Fest parking map"
                    class="pf-map-img"
                    loading="lazy"
                  />
                  <span class="pf-map-tap-hint">
                    <i class="fa-solid fa-magnifying-glass-plus" /> Tap to
                    enlarge
                  </span>
                </a>
              </div>
            )}
            {VENDOR_MAP_IMAGE_URL && (
              <div class="pf-map-item">
                <h3>Vendor Map</h3>
                <a href={VENDOR_MAP_IMAGE_URL} target="_blank" rel="noopener">
                  <img
                    src={VENDOR_MAP_IMAGE_URL}
                    alt="Pond Fest vendor map"
                    class="pf-map-img"
                    loading="lazy"
                  />
                  <span class="pf-map-tap-hint">
                    <i class="fa-solid fa-magnifying-glass-plus" /> Tap to
                    enlarge
                  </span>
                </a>
              </div>
            )}
          </div>
        )
      }
      {
        planNotes.map((note) => (
          <div class="pf-info-note">
            <i class={`fa-solid ${note.icon}`} />
            <p>{note.text}</p>
          </div>
        ))
      }
      <p class="pf-plan-hashtags">
        Share your day: {HASHTAGS.join(" ")}
      </p>
    </div>
  </section>

  <!-- ══ MUSIC LINEUP ═══════════════════════════════════════════════ -->
  <section class="pf-section pf-section--dark" id="pf-lineup">
    <div class="pf-section-inner">
      {
        hasLineup ? (
          <>
            <div class="pf-lineup-header">
              <span class="pf-eyebrow">Live Music</span>
              <h2>Music Lineup</h2>
              <p class="pf-lineup-intro">
                Eleven acts across three stages: Wingspan and Monarch in Area 1,
                and the Nest Box pavilion stage in Area 2. Every performer is
                donating their time, so the music you hear all day is money that
                stays with the park. Set times go up as soon as we have them, so
                follow us on{" "}
                <a href={FACEBOOK_URL} target="_blank" rel="noopener">
                  Facebook
                </a>{" "}
                if you don't want to miss your favorites.
              </p>
            </div>
            <div class="pf-lineup-list">
              {LINEUP.map((performer, i) => (
                <article class:list={["pf-act", i % 2 === 1 && "pf-act--flip"]}>
                  <div
                    class="pf-act-media"
                    style={
                      performer.imageWidth && performer.imageHeight
                        ? `--pf-act-ar: ${Math.max(
                            0.9,
                            performer.imageWidth / performer.imageHeight,
                          ).toFixed(3)};`
                        : undefined
                    }
                  >
                    {performer.imageUrl ? (
                      <img
                        src={performer.imageUrl}
                        alt={`${performer.name}, performing live`}
                        width={performer.imageWidth}
                        height={performer.imageHeight}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span class="pf-act-monogram" aria-hidden="true">
                        {monogram(performer.name)}
                      </span>
                    )}
                  </div>
