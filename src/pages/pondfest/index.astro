              </p>
              <div class="pf-food-areas">
                {foodByArea.map((g) => (
                  <div class="pf-food-area">
                    <h4>
                      {hasMapView ? (
                        <a
                          class="pf-area-chip pf-here-area"
                          href={`#pf-maptab-area-${g.area}`}
                          data-pf-map={`area-${g.area}`}
