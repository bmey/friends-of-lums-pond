---
import { Image } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import { getUrl } from "../components/getUrl";
import Header from "../components/Header.astro";
import IndexTeaser from "../components/IndexTeaser.astro";
import { JOIN_URL, SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import Hero from "../images/HERO.jpeg";
import PondFestLogo from "../images/pondfest.png";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <div class="banner">
        <Image src={Hero} alt="kayak at lums pond" />
        <div class="hero-cutout">
          <div class="hero-cutout-1">Friends of</div>
          <div class="hero-cutout-2">Lums Pond</div>
        </div>
        <h1 class="sr-only">Friends of Lums Pond State Park</h1>
      </div>
      <div class="description">
        Welcome to the website of the Friends of Lums Pond State Park. Our
        Friends Group helps the park as it serves the public.
      </div>
      <div class="teasers">
        <IndexTeaser title="Pond Fest 2027" art="/home/card-pondfest.webp">
          <Image slot="mark" src={PondFestLogo} alt="" width="40" height="40" />
          <p>
            Saturday, October 9. Live music on three stages, a beer garden, food
            trucks, and a full day of family fun across three areas of the park.
            Free to attend.
          </p>
          <a href={getUrl("pondfest")}>See Pond Fest 2027</a>
        </IndexTeaser>

        <IndexTeaser
          icon="fa-person-running"
          title="Halfway to Pond Fest 5K"
          art="/home/card-5k.webp"
          artFit="contain"
        >
          <p>
            Our spring fundraiser: a 5K through Middletown on Sunday, April 4,
            starting and finishing at Volunteer Brewing. $25 through January 10.
          </p>
          <a href={getUrl("blog/26-11-18-halfway-5k-2027/")}>
            5K details and sign-up
          </a>
        </IndexTeaser>

        <IndexTeaser
          icon="fa-magnifying-glass"
          title="About"
          art="/home/card-about.webp"
        >
          <p>
            A nonprofit on a mission to protect and enhance Lums Pond State
            Park. What we do, the benefits of joining us, and the park's
            history.
          </p>
          <a href={getUrl("about")}>Learn more</a>
        </IndexTeaser>

        <IndexTeaser
          icon="fa-user-plus"
          title="Volunteer"
          art="/home/card-volunteer.webp"
        >
          <p>
            Members have a vote in how the group is run and pitch in on trail
            days, boathouse clean-ups, and Pond Fest.
          </p>
          <a href={JOIN_URL}>Become a member</a>
        </IndexTeaser>
      </div>
    </main>
    <Footer />
    <style>
      .description {
        font-size: 1.5rem;
        padding: 2rem;
        text-align: center;
      }
      /* Two up on a desktop rather than three and an orphan, and every card
         stretches to the height of its row. */
      .teasers {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
        max-width: 940px;
        margin: 3rem auto;
        padding: 0 1rem;
      }
      @media (min-width: 720px) {
        .teasers {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      .teasers p {
        font-size: 0.9rem;
        line-height: 1.55;
        color: var(--color-gray-600);
        margin: 0 0 1.25rem;
      }

      /* margin-top:auto drops the button to the foot of the card, so a short
         card and a long one hand you the button at the same place. */
      .teasers a {
        margin-top: auto;
        align-self: flex-start;
        background: var(--color-primary-800);
        border-radius: 0.5rem;
        border: none;
        color: white;
        cursor: pointer;
        font-size: 0.9rem;
        padding: 0.55rem 1.1rem;
        text-decoration: none;
        transition: background 0.3s ease;
      }
      .teasers a:hover,
      .teasers a:focus {
        background: var(--color-primary-600);
      }

      .hero-cutout {
        position: absolute;
        height: 100%;
        width: 100%;
        overflow: hidden;
        z-index: -1;
        background-color: rgba(var(--color-gray-rgb-50), 0.9);
        mix-blend-mode: screen;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        align-content: center;
        justify-content: start;
        font-family: var(--font-header);
        text-transform: uppercase;
      }
      .hero-cutout-1 {
        letter-spacing: -0.5rem;
        font-size: max(min(23vw, 24vh), 10rem);
        line-height: max(min(23vw, 24vh), 10rem);
      }
      .hero-cutout-2 {
        letter-spacing: -1rem;
        font-size: max(min(50vw, 54vh), 20rem);
        line-height: max(min(30vw, 40vh), 18rem);
      }

      @media only screen and (max-width: 700px) {
        .hero-cutout {
          justify-content: center;
        }
        .hero-cutout-1 {
          margin-bottom: 0.5rem;
          font-size: max(min(15vw, 15vh), 6rem);
          line-height: max(min(15vw, 15vh), 6rem);
        }
        .hero-cutout-2 {
          font-size: max(min(50vw, 54vh), 15rem);
          line-height: calc(max(min(50vw, 54vh), 15rem) - 5rem);
        }
      }

      main {
        width: 100%;
      }

      .banner {
        height: calc(100vh - 78px);
        width: 100%;
        overflow: hidden;
        position: relative;
        display: flex;
        flex-direction: column;
      }

      .banner > img {
        position: absolute;
        object-fit: cover;
        height: 100%;
        width: 100%;
        z-index: -2;
      }
    </style>
  </body>
</html>
