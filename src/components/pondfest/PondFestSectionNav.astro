---
// Sticky section nav for the (very long) Pond Fest page.
//
// Three pieces that share one script and one set of observers:
//   1. a slim bar that pins once #pf-quicklinks has scrolled away, whose
//      label rolls over to whichever section you are currently in
//   2. a bottom sheet listing every destination, opened from that bar
//   3. a back-to-top button
//
// Both nav lists are rendered here. The page's applyEventMode() flips
// data-mode between "pre" and "day" the same week it reveals the day-of
// panel, so event day gets an action list instead of a tour of the page.
import type { NavSection } from "../../data/pondfest/types";

interface Props {
  sections: NavSection[];
  dayOfLinks: NavSection[];
  donateUrl?: string;
}

const { sections, dayOfLinks, donateUrl } = Astro.props;

const isOnPage = (href: string) => href.startsWith("#");
---

<div id="pf-sectionnav" class="pf-sectionnav" data-mode="pre">
  <!-- ── The sticky bar ── -->
  <nav class="pf-navbar" aria-label="Page sections">
    <span class="pf-navbar-current">
      <i class="fa-solid fa-location-arrow" aria-hidden="true"></i>
      <span class="pf-navbar-label" data-pf-current>Pond Fest</span>
    </span>
    <button
      type="button"
      class="pf-navbar-jump"
      data-pf-jump-open
      aria-expanded="false"
      aria-haspopup="dialog"
      aria-controls="pf-jump-sheet"
    >
      Jump to
      <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
    </button>
  </nav>

  <!-- ── The jump sheet ── -->
  <div class="pf-sheet-backdrop" data-pf-jump-close hidden></div>
  <div
    id="pf-jump-sheet"
    class="pf-sheet"
    role="dialog"
    aria-modal="true"
    aria-label="Jump to a section"
    hidden
  >
    <div class="pf-sheet-head">
      <h2 class="pf-sheet-title">Jump to</h2>
      <button type="button" class="pf-sheet-close" data-pf-jump-close>
        <span class="sr-only">Close</span>
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
    </div>

    {
      donateUrl && (
        <a
          href={donateUrl}
          class="pf-sheet-donate"
          target="_blank"
          rel="noopener"
        >
          <i class="fa-solid fa-circle-dollar-to-slot" aria-hidden="true" />
          Donate to Pond Fest
        </a>
      )
    }

    <ul class="pf-sheet-list" data-pf-list="pre">
      {
        sections.map((s) => (
          <li>
            <a
              href={s.href}
              class="pf-sheet-row"
              data-pf-target={isOnPage(s.href) ? s.href.slice(1) : undefined}
            >
              <i
                class={`fa-solid ${s.icon} pf-sheet-icon`}
                aria-hidden="true"
              />
              <span class="pf-sheet-row-label">{s.label}</span>
              <i
                class="fa-solid fa-chevron-right pf-sheet-chevron"
                aria-hidden="true"
              />
            </a>
          </li>
        ))
      }
    </ul>

    <ul class="pf-sheet-list" data-pf-list="day" hidden>
      {
        dayOfLinks.map((s) => (
          <li>
            <a
              href={s.href}
              class="pf-sheet-row"
              data-pf-target={isOnPage(s.href) ? s.href.slice(1) : undefined}
              target={isOnPage(s.href) ? undefined : "_blank"}
              rel={isOnPage(s.href) ? undefined : "noopener"}
            >
              <i
                class={`fa-solid ${s.icon} pf-sheet-icon`}
                aria-hidden="true"
              />
              <span class="pf-sheet-row-label">{s.label}</span>
              <i
                class={`fa-solid ${
                  isOnPage(s.href)
                    ? "fa-chevron-right"
                    : "fa-arrow-up-right-from-square"
                } pf-sheet-chevron`}
                aria-hidden="true"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- ── Back to top ── -->
  <button type="button" class="pf-backtotop" data-pf-top>
    <span class="sr-only">Back to top</span>
    <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
  </button>
</div>

<!-- Two viewports down. Once this is passed, back-to-top is worth offering. -->
<div id="pf-top-sentinel" aria-hidden="true"></div>

<style>
  /* ══ Sticky bar ══════════════════════════════════════════════════ */
  .pf-navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 4;
    height: var(--pf-nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 clamp(0.75rem, 4vw, 2rem);
    background: rgba(11, 9, 23, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    box-sizing: border-box;
    /* hidden until the quick-links row scrolls away */
    transform: translateY(-100%);
    visibility: hidden;
    transition:
      transform 0.25s ease,
      visibility 0.25s ease;
  }
  .pf-sectionnav.is-pinned .pf-navbar {
    transform: translateY(0);
    visibility: visible;
  }

  .pf-navbar-current {
    display: flex;
    align-items: center;
    gap: 0.5em;
    min-width: 0; /* lets the label truncate instead of shoving the button */
    color: #fff;
    font-size: clamp(0.85rem, 2.2vw, 1rem);
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .pf-navbar-current > i {
    color: var(--pf-teal);
    font-size: 0.8em;
    flex-shrink: 0;
  }
  .pf-navbar-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: opacity 0.15s ease;
  }
  .pf-navbar-label.is-swapping {
    opacity: 0;
  }

  .pf-navbar-jump {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    flex-shrink: 0;
    /* 44px tall inside a 48px bar keeps the tap target honest */
    min-height: 44px;
    padding: 0 0.9rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    font-family: inherit;
    font-size: clamp(0.8rem, 2vw, 0.9rem);
    font-weight: 700;
    cursor: pointer;
    transition:
      background 0.15s ease,
      border-color 0.15s ease;
  }
  .pf-navbar-jump:hover,
  .pf-navbar-jump:focus-visible {
    background: rgba(255, 255, 255, 0.2);
    border-color: var(--pf-teal);
  }
  .pf-navbar-jump i {
    font-size: 0.75em;
    transition: transform 0.2s ease;
  }
  .pf-navbar-jump[aria-expanded="true"] i {
    transform: rotate(180deg);
  }

  /* ══ Jump sheet ══════════════════════════════════════════════════ */
  .pf-sheet-backdrop {
    position: fixed;
    inset: 0;
    z-index: 6;
    background: rgba(11, 9, 23, 0.6);
    backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .pf-sheet-backdrop.is-open {
    opacity: 1;
  }

  .pf-sheet {
    position: fixed;
    z-index: 6;
    left: 0;
    right: 0;
    bottom: 0;
    max-height: 85vh;
    overflow-y: auto;
    padding: 0.75rem clamp(1rem, 4vw, 1.5rem)
      calc(1.25rem + env(safe-area-inset-bottom));
    background: var(--pf-dark-alt);
    border-top: 2px solid var(--pf-teal);
    border-radius: 16px 16px 0 0;
    box-shadow: 0 -8px 40px rgba(0, 0, 0, 0.5);
    transform: translateY(100%);
    transition: transform 0.25s ease;
  }
  .pf-sheet.is-open {
    transform: translateY(0);
  }
  /* on a wide screen it reads better as a panel under the bar than as a
     full-width sheet glued to the bottom of a 27-inch monitor */
  @media (min-width: 720px) {
    .pf-sheet {
      left: auto;
      bottom: auto;
      top: calc(var(--pf-nav-h) + 8px);
      right: clamp(0.75rem, 4vw, 2rem);
      width: 340px;
      max-height: calc(100vh - var(--pf-nav-h) - 24px);
      border-radius: 12px;
      border-top-width: 2px;
      transform: translateY(-8px);
      opacity: 0;
      transition:
        transform 0.2s ease,
        opacity 0.2s ease;
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.55);
    }
    .pf-sheet.is-open {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .pf-sheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.25rem 0 0.5rem;
  }
  .pf-sheet-title {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--pf-teal);
  }
  .pf-sheet-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin-right: -0.5rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: rgba(255, 255, 255, 0.7);
    font-size: 1.1rem;
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  .pf-sheet-close:hover,
  .pf-sheet-close:focus-visible {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  .pf-sheet-donate {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    min-height: 48px;
    margin-bottom: 0.5rem;
    border-radius: 8px;
    background: var(--pf-teal);
    color: #fff;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .pf-sheet-donate:hover,
  .pf-sheet-donate:focus-visible {
    background: var(--pf-teal-light);
    color: #fff;
  }

  .pf-sheet-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pf-sheet-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 48px;
    padding: 0.5rem 0.5rem;
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.98rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  .pf-sheet-row:hover,
  .pf-sheet-row:focus-visible {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }
  .pf-sheet-row[aria-current="true"] {
    background: rgba(42, 196, 179, 0.14);
    color: #fff;
  }
  .pf-sheet-row[aria-current="true"] .pf-sheet-icon {
    color: var(--pf-teal-light);
  }
  .pf-sheet-icon {
    width: 1.25em;
    text-align: center;
    color: rgba(255, 255, 255, 0.45);
    flex-shrink: 0;
  }
  .pf-sheet-row-label {
    flex: 1;
    min-width: 0;
  }
  .pf-sheet-chevron {
    font-size: 0.7em;
    color: rgba(255, 255, 255, 0.3);
    flex-shrink: 0;
  }

  /* ══ Back to top ═════════════════════════════════════════════════ */
  .pf-backtotop {
    position: fixed;
    z-index: 3;
    right: clamp(0.85rem, 4vw, 2rem);
    bottom: calc(clamp(0.85rem, 4vw, 2rem) + env(safe-area-inset-bottom));
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    background: rgba(61, 47, 122, 0.92);
    backdrop-filter: blur(8px);
    color: #fff;
    font-size: 1rem;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.45);
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      visibility 0.25s ease,
      background 0.15s ease;
  }
  .pf-sectionnav.is-deep .pf-backtotop {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .pf-backtotop:hover,
  .pf-backtotop:focus-visible {
    background: var(--pf-teal);
    border-color: var(--pf-teal-light);
  }

  #pf-top-sentinel {
    position: absolute;
    top: 200vh;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  /* ══ Day-of mode ═════════════════════════════════════════════════ */
  /* Standing at the gate, nobody should have to scroll past the hero to
     find the map. The bar is pinned from the very top instead. */
  .pf-sectionnav[data-mode="day"] .pf-navbar {
    transform: translateY(0);
    visibility: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .pf-navbar,
    .pf-sheet,
    .pf-sheet-backdrop,
    .pf-backtotop,
    .pf-navbar-label,
    .pf-navbar-jump i {
      transition: none;
    }
  }

  @media print {
    .pf-sectionnav {
      display: none;
    }
  }
</style>

<script>
  function setupSectionNav() {
    const root = document.getElementById("pf-sectionnav");
    if (!root) return;

    const bar = root.querySelector(".pf-navbar") as HTMLElement | null;
    const label = root.querySelector("[data-pf-current]") as HTMLElement | null;
    const openBtn = root.querySelector(
      "[data-pf-jump-open]",
    ) as HTMLButtonElement | null;
    const sheet = document.getElementById("pf-jump-sheet");
    const backdrop = root.querySelector(
      ".pf-sheet-backdrop",
    ) as HTMLElement | null;
    const topBtn = root.querySelector("[data-pf-top]") as HTMLElement | null;
    if (!bar || !label || !openBtn || !sheet || !backdrop || !topBtn) return;

    const observers: IntersectionObserver[] = [];
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const behavior: ScrollBehavior = reduceMotion ? "auto" : "smooth";

    const navH =
      parseInt(
        getComputedStyle(document.documentElement).getPropertyValue(
          "--pf-nav-h",
        ),
        10,
      ) || 48;

    // ── Pin the bar once the quick-links row has scrolled away ──
    const quicklinks = document.getElementById("pf-quicklinks");
    if (quicklinks) {
      const pinObserver = new IntersectionObserver(
        ([entry]) => {
          // Not intersecting means one of two very different things: the row
          // is above us (scrolled past — pin) or still below us under the
          // hero (page load — leave the site header alone). Only the first
          // puts the row's top above the viewport.
          const scrolledPast =
            !entry.isIntersecting && entry.boundingClientRect.top < 0;
          root.classList.toggle("is-pinned", scrolledPast);
          // A sheet left open while the bar slides away would float free
          if (!scrolledPast) closeSheet();
        },
        { threshold: 0, rootMargin: `-${navH}px 0px 0px 0px` },
      );
      pinObserver.observe(quicklinks);
      observers.push(pinObserver);
    }

    // ── Back-to-top, once we are two viewports down ──
    const deepSentinel = document.getElementById("pf-top-sentinel");
    if (deepSentinel) {
      const deepObserver = new IntersectionObserver(
        ([entry]) => {
          // boundingClientRect.top < 0 means the sentinel is above us
          root.classList.toggle(
            "is-deep",
            !entry.isIntersecting && entry.boundingClientRect.top < 0,
          );
        },
        { threshold: 0 },
      );
      deepObserver.observe(deepSentinel);
      observers.push(deepObserver);
    }

    // ── Roll the label over to the section we are currently in ──
    const rows = Array.from(
      sheet.querySelectorAll("[data-pf-target]"),
    ) as HTMLAnchorElement[];

    // A section can appear in both nav lists, so map id -> label once and
    // keep every row pointing at it in sync.
    const targets = new Map<string, string>();
    rows.forEach((row) => {
      const id = row.dataset.pfTarget;
      const text = row.querySelector(".pf-sheet-row-label")?.textContent;
      if (id && text && !targets.has(id)) targets.set(id, text.trim());
    });

    const visible = new Set<string>();
    let currentId = "";

    const setCurrent = (id: string) => {
      if (id === currentId) return;
      currentId = id;
      const text = targets.get(id) || "Pond Fest";

      if (reduceMotion) {
        label.textContent = text;
      } else {
        label.classList.add("is-swapping");
        window.setTimeout(() => {
          label.textContent = text;
          label.classList.remove("is-swapping");
        }, 150);
      }

      rows.forEach((row) => {
        if (row.dataset.pfTarget === id)
          row.setAttribute("aria-current", "true");
        else row.removeAttribute("aria-current");
      });
    };

    // The band we care about is a strip just under the bar. A section is
    // "current" from the moment its top slides under the bar until the next
    // one does the same.
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const id = entry.target.id;
          if (entry.isIntersecting) visible.add(id);
          else visible.delete(id);
        });
        if (!visible.size) return;
        // Several can qualify at once; take the one furthest down the page.
        const winner = Array.from(visible)
          .map((id) => document.getElementById(id))
          .filter((el): el is HTMLElement => !!el)
          .sort((a, b) => a.offsetTop - b.offsetTop)
          .pop();
        if (winner) setCurrent(winner.id);
      },
      { rootMargin: `-${navH + 1}px 0px -70% 0px`, threshold: 0 },
    );
    targets.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) sectionObserver.observe(el);
    });
    observers.push(sectionObserver);

    // ── The sheet ──
    let lastFocused: HTMLElement | null = null;

    function openSheet() {
      if (!sheet || !backdrop || !openBtn) return;
      lastFocused = document.activeElement as HTMLElement;
      backdrop.hidden = false;
      sheet.hidden = false;
      // one frame, so the transition has a starting point to animate from
      requestAnimationFrame(() => {
        backdrop.classList.add("is-open");
        sheet.classList.add("is-open");
      });
      openBtn.setAttribute("aria-expanded", "true");
      const first = sheet.querySelector(
        "a:not([hidden]), button",
      ) as HTMLElement | null;
      first?.focus();
      document.addEventListener("keydown", onKeydown);
    }

    function closeSheet() {
      if (!sheet || !backdrop || !openBtn) return;
      if (sheet.hidden) return;
      backdrop.classList.remove("is-open");
      sheet.classList.remove("is-open");
      openBtn.setAttribute("aria-expanded", "false");
      document.removeEventListener("keydown", onKeydown);
      const hide = () => {
        sheet.hidden = true;
        backdrop.hidden = true;
      };
      if (reduceMotion) hide();
      else window.setTimeout(hide, 250);
      lastFocused?.focus();
      lastFocused = null;
    }

    function onKeydown(e: KeyboardEvent) {
      if (e.key === "Escape") {
        e.preventDefault();
        closeSheet();
        return;
      }
      if (e.key !== "Tab" || !sheet) return;
      // Keep tabbing inside the sheet while it is modal
      const focusables = Array.from(
        sheet.querySelectorAll("a[href], button:not([disabled])"),
      ).filter(
        (el) => (el as HTMLElement).offsetParent !== null,
      ) as HTMLElement[];
      if (!focusables.length) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }

    openBtn.addEventListener("click", () => {
      if (sheet.hidden) openSheet();
      else closeSheet();
    });
    root
      .querySelectorAll("[data-pf-jump-close]")
      .forEach((el) => el.addEventListener("click", () => closeSheet()));
    // Tapping a destination closes the sheet; the browser handles the jump,
    // and scroll-margin-top keeps the heading clear of the bar.
    sheet
      .querySelectorAll(".pf-sheet-row")
      .forEach((el) => el.addEventListener("click", () => closeSheet()));

    // ── Back to top ──
    topBtn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior });
      // Send focus where sighted users just landed
      const h1 = document.querySelector("h1") as HTMLElement | null;
      if (h1) {
        h1.setAttribute("tabindex", "-1");
        h1.focus({ preventScroll: true });
      }
    });

    // Astro view transitions swap the DOM out from under us
    document.addEventListener(
      "astro:before-swap",
      () => {
        observers.forEach((o) => o.disconnect());
        document.removeEventListener("keydown", onKeydown);
      },
      { once: true },
    );
  }

  setupSectionNav();
  document.addEventListener("astro:after-swap", setupSectionNav);
</script>
